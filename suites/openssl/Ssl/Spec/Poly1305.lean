import Ssl.Bytes
/-!
# Specification: RFC 8439 Poly1305

Clamping (§2.5), the polynomial over 2^130-5 with the per-block pad, `(… mod p + s) mod 2^128`.
Checked against RFC 8439 vectors by kernel evaluation below, and against a reference implementation
by `tools/spec_vectors.py`.
-/
namespace Ssl.Spec.Poly1305
open Ssl

/-- The prime 2^130 - 5. -/
def p : Nat := 2 ^ 130 - 5
/-- Little-endian value of a byte list. -/
def leNat (bs : List UInt8) : Nat := bs.foldr (fun b acc => b.toNat + 256 * acc) 0
/-- `n` little-endian bytes of `v`. -/
def leBytes (n : Nat) (v : Nat) : List UInt8 :=
  (List.range n).map fun i => ((v >>> (8 * i)) % 256).toUInt8
/-- RFC 8439 §2.5: `r` is the first 16 key bytes with the "clamp" bits cleared. -/
def clampMask : Nat := 0x0ffffffc0ffffffc0ffffffc0fffffff
def r (key : List UInt8) : Nat := leNat (key.take 16) &&& clampMask
/-- `s` is the second 16 key bytes. -/
def s (key : List UInt8) : Nat := leNat ((key.drop 16).take 16)
/-- The message as 16-byte blocks, the last possibly shorter (never empty). -/
def blocksAux : Nat → List UInt8 → List (List UInt8)
  | 0, _ => []
  | _, [] => []
  | n + 1, bs => bs.take 16 :: blocksAux n (bs.drop 16)
def blocks (msg : List UInt8) : List (List UInt8) := blocksAux msg.length msg
/-- `Σ_{i=1}^{q} (m_i + 2^(8·|m_i|)) · r^(q-i+1)` over the blocks `m_1 … m_q` (the pad is 2^128 for a
full block, 2^(8·len) for the final short one). -/
def poly (r : Nat) (bl : List (List UInt8)) : Nat :=
  let q := bl.length
  (List.range q).foldl (fun acc i => acc + (leNat bl[i]! + 2 ^ (8 * bl[i]!.length)) * r ^ (q - i)) 0
/-- The RFC 8439 Poly1305 tag as a number: `(poly mod p + s) mod 2^128`. -/
def tagNat (key msg : List UInt8) : Nat := (poly (r key) (blocks msg) % p + s key) % 2 ^ 128
/-- The 16-byte Poly1305 tag of `msg` under the 32-byte `key`. -/
def poly1305 (key msg : List UInt8) : List UInt8 := leBytes 16 (tagNat key msg)

set_option maxRecDepth 100000 in
/-- RFC 8439 §2.5.2 test vector (key, "Cryptographic Forum Research Group", tag `a8061dc1…27a9`). -/
theorem rfc8439_vector :
    tagNat [0x85, 0xd6, 0xbe, 0x78, 0x57, 0x55, 0x6d, 0x33, 0x7f, 0x44, 0x52, 0xfe, 0x42, 0xd5, 0x06, 0xa8,
            0x01, 0x03, 0x80, 0x8a, 0xfb, 0x0d, 0xb2, 0xfd, 0x4a, 0xbf, 0xf6, 0xaf, 0x41, 0x49, 0xf5, 0x1b]
      [0x43, 0x72, 0x79, 0x70, 0x74, 0x6f, 0x67, 0x72, 0x61, 0x70, 0x68, 0x69, 0x63, 0x20, 0x46, 0x6f, 0x72,
       0x75, 0x6d, 0x20, 0x52, 0x65, 0x73, 0x65, 0x61, 0x72, 0x63, 0x68, 0x20, 0x47, 0x72, 0x6f, 0x75, 0x70] =
    0xa927010caf8b2bc2c6365130c11d06a8 := by
  decide

set_option maxRecDepth 100000 in
/-- The empty message: the tag is `s`. -/
theorem rfc8439_empty :
    tagNat [0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10,
            0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f, 0x20]
      [] =
    0x201f1e1d1c1b1a191817161514131211 := by
  decide

set_option maxRecDepth 100000 in
/-- Maximal clamped `r`, maximal `s` and three all-ones blocks: carries through 2^130-5 and 2^128. -/
theorem poly1305_carries :
    tagNat [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff]
      [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
       0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
       0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff] =
    0xe4957c9975507c784cecfc516b6afc5e := by
  decide

set_option maxRecDepth 100000 in
/-- A full block followed by a one-byte block (pad bit at 2^8). -/
theorem poly1305_partial_block :
    tagNat [0x85, 0xd6, 0xbe, 0x78, 0x57, 0x55, 0x6d, 0x33, 0x7f, 0x44, 0x52, 0xfe, 0x42, 0xd5, 0x06, 0xa8,
            0x01, 0x03, 0x80, 0x8a, 0xfb, 0x0d, 0xb2, 0xfd, 0x4a, 0xbf, 0xf6, 0xaf, 0x41, 0x49, 0xf5, 0x1b]
      [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
       0x01] =
    0x845b545878ce3571fe6fe87341446512 := by
  decide
end Ssl.Spec.Poly1305
