/-- The block counter wraps modulo 2^32 without touching the nonce words (a choice of this
specification; see the module documentation). -/
theorem advance_wraps : advance (rfcState.set! 12 0xffffffff) 1 = rfcState.set! 12 0 := by
  decide
end Ssl.Spec.Chacha
