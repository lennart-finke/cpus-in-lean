import Ssl.Bytes
/-!
# Specification: RFC 8439 ChaCha (block function, keystream, encryption) and HChaCha

Quarter round (§2.1), double round and block function (§2.3), keystream xor with counter increment
(§2.4), HChaCha of draft-irtf-cfrg-xchacha §2.2. Checked against RFC vectors by kernel evaluation
below, and against a reference implementation by `tools/spec_vectors.py`.

RFC 8439 does not define what happens when the 32-bit block counter overflows. `advance` wraps it
modulo 2^32 and leaves the nonce words alone; that is a choice of this specification (it is what
`ChaCha20_ctr32` implementations do), not something the RFC states.
-/
namespace Ssl.Spec.Chacha
open Ssl

def rotl (x : UInt32) (n : UInt32) : UInt32 := (x <<< n) ||| (x >>> (32 - n))

/-- RFC 8439 §2.1: the quarter round on words `a`, `b`, `c`, `d` of the state. -/
def quarterRound (s : Array UInt32) (a b c d : Nat) : Array UInt32 :=
  let va := s[a]! + s[b]!
  let vd := rotl (s[d]! ^^^ va) 16
  let vc := s[c]! + vd
  let vb := rotl (s[b]! ^^^ vc) 12
  let va := va + vb
  let vd := rotl (vd ^^^ va) 8
  let vc := vc + vd
  let vb := rotl (vb ^^^ vc) 7
  (((s.set! a va).set! b vb).set! c vc).set! d vd

/-- RFC 8439 §2.3: a column round followed by a diagonal round. -/
def doubleRound (s : Array UInt32) : Array UInt32 :=
  let s := quarterRound s 0 4 8 12
  let s := quarterRound s 1 5 9 13
  let s := quarterRound s 2 6 10 14
  let s := quarterRound s 3 7 11 15
  let s := quarterRound s 0 5 10 15
  let s := quarterRound s 1 6 11 12
  let s := quarterRound s 2 7 8 13
  quarterRound s 3 4 9 14

/-- `nrounds` rounds are `nrounds / 2` double rounds (20 for ChaCha20, 12 for ChaCha12). -/
def permute (nrounds : Nat) (s : Array UInt32) : Array UInt32 := Nat.repeat doubleRound (nrounds / 2) s

/-- RFC 8439 §2.3: the block function. The keystream block is the permuted state plus the input state,
serialised as 16 little-endian words. -/
def block (nrounds : Nat) (s : Array UInt32) : List UInt8 :=
  let x := permute nrounds s
  (List.range 16).flatMap fun i => le32 (x[i]! + s[i]!)

/-- HChaCha (draft-irtf-cfrg-xchacha §2.2): words 0..3 and 12..15 of the permuted state, without the
feed-forward, as 8 little-endian words. -/
def hchacha (nrounds : Nat) (s : Array UInt32) : List UInt8 :=
  let x := permute nrounds s
  [0, 1, 2, 3, 12, 13, 14, 15].flatMap fun i => le32 x[i]!

/-- The state after `n` blocks: the block counter (word 12) advanced by `n` modulo 2^32. -/
def advance (s : Array UInt32) (n : Nat) : Array UInt32 := s.set! 12 (s[12]! + n.toUInt32)

/-- RFC 8439 §2.4: the keystream of `n` consecutive blocks. -/
def keystream (nrounds : Nat) (s : Array UInt32) : Nat → List UInt8
  | 0 => []
  | n + 1 => block nrounds s ++ keystream nrounds (advance s 1) n

/-- RFC 8439 §2.4: encryption (and decryption) is the xor with the keystream prefix. -/
def crypt (nrounds : Nat) (s : Array UInt32) (src : List UInt8) : List UInt8 :=
  List.zipWith (· ^^^ ·) src (keystream nrounds s ((src.length + 63) / 64))

/-- RFC 8439 §2.3.2: key `00 01 … 1f`, nonce `00:00:00:09:00:00:00:4a:00:00:00:00`, counter 1. -/
def rfcState : Array UInt32 :=
  #[0x61707865, 0x3320646e, 0x79622d32, 0x6b206574, 0x03020100, 0x07060504, 0x0b0a0908, 0x0f0e0d0c,
    0x13121110, 0x17161514, 0x1b1a1918, 0x1f1e1d1c, 0x00000001, 0x09000000, 0x4a000000, 0x00000000]

set_option maxRecDepth 100000 in
/-- RFC 8439 §2.3.2 "Serialized Block". -/
theorem rfc8439_block :
    block 20 rfcState =
      [0x10, 0xf1, 0xe7, 0xe4, 0xd1, 0x3b, 0x59, 0x15, 0x50, 0x0f, 0xdd, 0x1f, 0xa3, 0x20, 0x71, 0xc4,
       0xc7, 0xd1, 0xf4, 0xc7, 0x33, 0xc0, 0x68, 0x03, 0x04, 0x22, 0xaa, 0x9a, 0xc3, 0xd4, 0x6c, 0x4e,
       0xd2, 0x82, 0x64, 0x46, 0x07, 0x9f, 0xaa, 0x09, 0x14, 0xc2, 0xd7, 0x05, 0xd9, 0x8b, 0x02, 0xa2,
       0xb5, 0x12, 0x9c, 0xd1, 0xde, 0x16, 0x4e, 0xb9, 0xcb, 0xd0, 0x83, 0xe8, 0xa2, 0x50, 0x3c, 0x4e] := by
  decide

set_option maxRecDepth 100000 in
/-- draft-irtf-cfrg-xchacha-03 §2.2.1: HChaCha20 with key `00 01 … 1f` and nonce
`00:00:00:09:00:00:00:4a:00:00:00:00:31:41:59:27` gives the subkey `82413b42 27b27bfe d30e4250 8a877d73
a0f9e4d5 8a74a853 c12ec413 26d3ecdc`. -/
theorem xchacha_hchacha20 :
    hchacha 20 #[0x61707865, 0x3320646e, 0x79622d32, 0x6b206574, 0x03020100, 0x07060504, 0x0b0a0908,
                 0x0f0e0d0c, 0x13121110, 0x17161514, 0x1b1a1918, 0x1f1e1d1c, 0x09000000, 0x4a000000,
                 0x00000000, 0x27594131] =
