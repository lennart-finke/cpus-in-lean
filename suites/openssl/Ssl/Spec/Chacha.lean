       0xa0, 0xf9, 0xe4, 0xd5, 0x8a, 0x74, 0xa8, 0x53, 0xc1, 0x2e, 0xc4, 0x13, 0x26, 0xd3, 0xec, 0xdc] := by
  decide

set_option maxRecDepth 100000 in
/-- RFC 8439 §2.4.2: the 114-byte "sunscreen" plaintext under key `00 01 … 1f`, nonce
`00:00:00:00:00:00:00:4a:00:00:00:00` and initial counter 1 (two keystream blocks, the second
partial). -/
theorem rfc8439_encryption :
    crypt 20 #[0x61707865, 0x3320646e, 0x79622d32, 0x6b206574, 0x03020100, 0x07060504, 0x0b0a0908,
               0x0f0e0d0c, 0x13121110, 0x17161514, 0x1b1a1918, 0x1f1e1d1c, 0x00000001, 0x00000000,
