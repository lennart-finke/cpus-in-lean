set_option maxRecDepth 100000 in
/-- A point of small order (`u = 0`) gives the all-zero result, which callers must reject. -/
theorem zero_point :
    x25519 [0x77, 0x07, 0x6d, 0x0a, 0x73, 0x18, 0xa5, 0x7d, 0x3c, 0x16, 0xc1, 0x72, 0x51, 0xb2, 0x66, 0x45,
            0xdf, 0x4c, 0x2f, 0x87, 0xeb, 0xc0, 0x99, 0x2a, 0xb1, 0x77, 0xfb, 0xa5, 0x1d, 0xb9, 0x2c, 0x2a]
           (List.replicate 32 0) = List.replicate 32 0 := by
  decide
end Ssl.Spec.X25519
