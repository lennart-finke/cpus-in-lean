import Ssl.Bytes
/-!
# Specification: RFC 7748 X25519

Scalar and u-coordinate decoding, the Montgomery ladder over `Nat` modulo 2^255-19 with
a24 = 121665, and inversion as z^(p-2) (§5); plus the limb offsets of the radix-2^25.5
representation that field-level statements refer to. Checked against the RFC 7748 §5.2 and §6.1
vectors by kernel evaluation below, and against a reference implementation by `tools/spec_vectors.py`.

This is the algorithm RFC 7748 specifies, not an independent definition of scalar multiplication
on Curve25519: a task proved against it shows that the machine code computes the RFC's function.
-/
namespace Ssl.Spec.X25519
open Ssl

/-- The prime 2^255 - 19. -/
def p : Nat := 2 ^ 255 - 19
/-- Little-endian value of a byte list. -/
def leNat (bs : List UInt8) : Nat := bs.foldr (fun b acc => b.toNat + 256 * acc) 0
/-- `n` little-endian bytes of `v`. -/
def leBytes (n : Nat) (v : Nat) : List UInt8 :=
  (List.range n).map fun i => ((v >>> (8 * i)) % 256).toUInt8

/-- Modular exponentiation by squaring (`fuel` bits of the exponent suffice). -/
def powModAux : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, _ => 1
  | fuel + 1, b, e, m =>
    if e = 0 then 1 % m
    else
      let h := powModAux fuel (b * b % m) (e / 2) m
      if e % 2 = 1 then h * b % m else h
def powMod (b e m : Nat) : Nat := powModAux 300 (b % m) e m
/-- `x⁻¹ = x^(p-2)` (and `0 ↦ 0`), as RFC 7748 §5 writes it. -/
def inv (x : Nat) : Nat := powMod x (p - 2) p
def addp (a b : Nat) : Nat := (a + b) % p
def subp (a b : Nat) : Nat := (a + p - b % p) % p
def mulp (a b : Nat) : Nat := a * b % p

/-- RFC 7748 §5 `decodeScalar25519`: clear the three low bits, clear bit 255, set bit 254. -/
def clamp (k : List UInt8) : List UInt8 :=
  (List.range 32).map fun i =>
    let b := k[i]!
    if i = 0 then b &&& 248 else if i = 31 then (b &&& 127) ||| 64 else b
def decodeScalar (k : List UInt8) : Nat := leNat (clamp k)
/-- RFC 7748 §5 `decodeUCoordinate`: mask the most significant bit of the last byte. -/
def decodeU (u : List UInt8) : Nat :=
  leNat ((List.range 32).map fun i => if i = 31 then u[i]! &&& 127 else u[i]!)

def a24 : Nat := 121665

/-- One ladder step (RFC 7748 §5, with the conditional swap folded in): state `(x₂, z₂, x₃, z₃, swap)`. -/
def ladderStep (x₁ : Nat) (st : Nat × Nat × Nat × Nat × Nat) (kt : Nat) : Nat × Nat × Nat × Nat × Nat :=
  let (x₂, z₂, x₃, z₃, swap) := st
  let swap := swap ^^^ kt
  let (x₂, x₃) := if swap = 1 then (x₃, x₂) else (x₂, x₃)
  let (z₂, z₃) := if swap = 1 then (z₃, z₂) else (z₂, z₃)
  let A := addp x₂ z₂
  let AA := mulp A A
  let B := subp x₂ z₂
  let BB := mulp B B
  let E := subp AA BB
  let C := addp x₃ z₃
  let D := subp x₃ z₃
  let DA := mulp D A
  let CB := mulp C B
  let x₃' := mulp (addp DA CB) (addp DA CB)
  let z₃' := mulp x₁ (mulp (subp DA CB) (subp DA CB))
  let x₂' := mulp AA BB
  let z₂' := mulp E (addp AA (mulp a24 E))
  (x₂', z₂', x₃', z₃', kt)

/-- The Montgomery ladder of RFC 7748 §5 over bits 254 … 0 of `k`; returns `x₂ · z₂^(p-2) mod p`. -/
def ladder (k u : Nat) : Nat :=
  let x₁ := u % p
  let st₀ : Nat × Nat × Nat × Nat × Nat := (1, 0, x₁, 1, 0)
  let (x₂, z₂, x₃, z₃, swap) :=
    (List.range 255).foldl (fun st i => ladderStep x₁ st ((k >>> (254 - i)) &&& 1)) st₀
  let (x₂, _) := if swap = 1 then (x₃, x₂) else (x₂, x₃)
  let (z₂, _) := if swap = 1 then (z₃, z₂) else (z₂, z₃)
  mulp x₂ (inv z₂)

/-- `X25519(k, u)` on 32-byte strings: the 32 little-endian bytes of the result. -/
def x25519 (k u : List UInt8) : List UInt8 := leBytes 32 (ladder (decodeScalar k) (decodeU u))

/-- Limb offsets of the radix-2^25.5 representation. -/
def off : Nat → Nat
  | 0 => 0 | 1 => 26 | 2 => 51 | 3 => 77 | 4 => 102 | 5 => 128 | 6 => 153 | 7 => 179 | 8 => 204 | 9 => 230
  | _ => 0
set_option maxRecDepth 100000 in
/-- RFC 7748 §5.2, first test vector (scalar `a046e36b…449a44`, u `e6db6867…ab1c4c`, output
`c3da5537…a28552` read little-endian), checked by kernel evaluation. -/
theorem rfc7748_vector :
    ladder (decodeScalar [0xa0, 0x46, 0xe3, 0x6b, 0xf0, 0x52, 0x7c, 0x9d, 0x3b, 0x16, 0x15, 0x4b, 0x82, 0x46,
                          0x5e, 0xdd, 0x62, 0x14, 0x4c, 0x0a, 0xc1, 0xfc, 0x5a, 0x18, 0x50, 0x6a, 0x22, 0x44,
                          0xba, 0x44, 0x9a, 0x44])
           (decodeU [0xe6, 0xdb, 0x68, 0x67, 0x58, 0x30, 0x30, 0xdb, 0x35, 0x94, 0xc1, 0xa4, 0x24, 0xb1,
                     0x5f, 0x7c, 0x72, 0x66, 0x24, 0xec, 0x26, 0xb3, 0x35, 0x3b, 0x10, 0xa9, 0x03, 0xa6,
                     0xd0, 0xab, 0x1c, 0x4c]) =
    0x5285a2775507b454f7711c4903cfec324f088df24dea948e90c6e99d3755dac3 := by
  decide

