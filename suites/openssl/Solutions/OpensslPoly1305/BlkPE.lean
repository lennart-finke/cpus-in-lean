import Solutions.OpensslPoly1305.BlkPro
import Solutions.OpensslPoly1305.BlkEnds
/-!
# Run pieces of `poly1305_blocks` (prologue and epilogue composites)

Generated by `gen/genblk.py` (`gen/psym.py`): each piece runs a few instructions by `cbv` from a
memory `N` described by `MemOK` (stack region `[U, U + 116)`, context `[C, C + 236)` of which the
first 20 bytes may be written), and states the values it computes as single-operation equations.
-/
namespace Solutions.OpensslPoly1305
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslPoly1305 Solutions.Exec.Mul Solutions.Exec.Fast
open Solutions.OpensslPoly1305.Cbv Solutions.Logic.Cmp

attribute [local cbv_opaque] Image.bytes
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option cbv.maxSteps 50000000
set_option exec.addrSub true
set_option autoImplicit false

theorem blk_pro (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (a0 inp ebx0 ebp0 esi0 edi0 g0 ret len pad h0 h1 h2 h3 h4 r0 r1 r2 r3 : UInt32)
        (hlU : LK lU [(104, ret), (108, len), (112, pad)])
    (hlC : LK lC [(0, h0), (4, h1), (8, h2), (12, h3), (16, h4), (20, r0), (24, r1), (28, r2), (32, r3)])
    (hinp : inp.toNat + 16 ≤ G.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat) :
    ∃ (N' : PMem) (lU' lC' : List (Nat × UInt32)) (g13 v12 v8 v4 : UInt32),
      Run img (St.m ⟨N.get, a0, C, inp, ebx0, UInt32.add U 104, ebp0, esi0, edi0, 0x1001b0, efl g0, icAdd ic0 0⟩)
        (St.m ⟨N'.get, len, C, inp, h3, UInt32.add U 4, ebp0, h4, r3, 0x100220, efl g13, icAdd ic0 46⟩) ∧
      MemOK G N' U 116 lU' C 236 20 lC' P ∧ LK lU' [(4, h0), (8, h2), (12, h1), (24, r0), (28, v12), (36, v8), (40, r1), (44, v4), (48, r2), (52, C), (56, r3), (88, esi0), (92, edi0), (96, ebx0), (100, ebp0), (104, ret), (108, len), (112, pad)] ∧ LK lC' [(0, h0), (4, h1), (8, h2), (12, h3), (16, h4), (20, r0), (24, r1), (28, r2), (32, r3)] ∧
      v4 = (addF 4 (UInt32.shiftRight r1 2) r1 0).1 ∧ v8 = (addF 4 (UInt32.shiftRight r2 2) r2 0).1 ∧ v12 = (addF 4 (UInt32.shiftRight r3 2) r3 0).1 := by
  obtain ⟨NN1, rr1, MM1⟩ := blk_pro0 ic0 hic G N U C _ _ P hM a0 inp ebx0 ebp0 esi0 edi0 g0 (by rw [hM.size]; exact hinp) hinpU
  have RR1 := rr1
  obtain ⟨g1, e_g1⟩ : ∃ y : UInt32, y = (subF 4 (UInt32.add U 88) 84 0).2 := ⟨_, rfl⟩
  obtain ⟨NN2, rr2, MM2⟩ := blk_pro1 ic0 hic G NN1 U C _ _ P MM1 a0 inp ebx0 ebp0 esi0 edi0 g0 g1 (by rw [MM1.size]; exact hinp) hinpU e_g1
  have RR2 := RR1.trans rr2
  obtain ⟨v2, e_v2⟩ : ∃ y : UInt32, y = UInt32.shiftRight r1 2 := ⟨_, rfl⟩
  obtain ⟨g3, e_g3⟩ : ∃ y : UInt32, y = Solutions.Logic.Cmp.shFl 5 r1 2 := ⟨_, rfl⟩
  obtain ⟨v4, e_v4⟩ : ∃ y : UInt32, y = (addF 4 v2 r1 0).1 := ⟨_, rfl⟩
  obtain ⟨g5, e_g5⟩ : ∃ y : UInt32, y = (addF 4 v2 r1 0).2 := ⟨_, rfl⟩
  obtain ⟨NN3, rr3, MM3⟩ := blk_pro2 ic0 hic G NN2 U C _ _ P MM2 a0 inp ebx0 ebp0 esi0 edi0 g1 r1 r2 r3 v2 g3 v4 g5 (MM2.rdC (k := 24) hlC.2.2.2.2.2.2.1 24 rfl) (MM2.rdC (k := 28) hlC.2.2.2.2.2.2.2.1 28 rfl) (MM2.rdC (k := 32) hlC.2.2.2.2.2.2.2.2.1 32 rfl) (by rw [MM2.size]; exact hinp) hinpU e_v2 e_g3 e_v4 e_g5
  have RR3 := RR2.trans rr3
  obtain ⟨v6, e_v6⟩ : ∃ y : UInt32, y = UInt32.shiftRight r2 2 := ⟨_, rfl⟩
  obtain ⟨g7, e_g7⟩ : ∃ y : UInt32, y = Solutions.Logic.Cmp.shFl 5 r2 2 := ⟨_, rfl⟩
  obtain ⟨v8, e_v8⟩ : ∃ y : UInt32, y = (addF 4 v6 r2 0).1 := ⟨_, rfl⟩
  obtain ⟨g9, e_g9⟩ : ∃ y : UInt32, y = (addF 4 v6 r2 0).2 := ⟨_, rfl⟩
  obtain ⟨v10, e_v10⟩ : ∃ y : UInt32, y = UInt32.shiftRight r3 2 := ⟨_, rfl⟩
  obtain ⟨g11, e_g11⟩ : ∃ y : UInt32, y = Solutions.Logic.Cmp.shFl 5 r3 2 := ⟨_, rfl⟩
  obtain ⟨NN4, rr4, MM4⟩ := blk_pro3 ic0 hic G NN3 U C _ _ P MM3 r1 inp v4 ebp0 r2 r3 g5 v6 g7 v8 g9 v10 g11 (by rw [MM3.size]; exact hinp) hinpU e_v6 e_g7 e_v8 e_g9 e_v10 e_g11
  have RR4 := RR3.trans rr4
  obtain ⟨v12, e_v12⟩ : ∃ y : UInt32, y = (addF 4 v10 r3 0).1 := ⟨_, rfl⟩
  obtain ⟨g13, e_g13⟩ : ∃ y : UInt32, y = (addF 4 v10 r3 0).2 := ⟨_, rfl⟩
  obtain ⟨NN5, rr5, MM5⟩ := blk_pro4 ic0 hic G NN4 U C _ _ P MM4 v10 inp v4 ebp0 r2 r3 g11 len r0 h0 h1 v12 g13 (MM4.rdU (k := 108) (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlU.2.1 rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) 108 rfl) (MM4.rdC (k := 20) hlC.2.2.2.2.2.1 20 rfl) (MM4.rdC0 hlC.1) (MM4.rdC (k := 4) hlC.2.1 4 rfl) (by rw [MM4.size]; exact hinp) hinpU e_v12 e_g13
  have RR5 := RR4.trans rr5
  obtain ⟨NN6, rr6, MM6⟩ := blk_pro5 ic0 hic G NN5 U C _ _ P MM5 len inp v4 ebp0 h1 r3 g13 h2 h3 h4 (MM5.rdC (k := 8) hlC.2.2.1 8 rfl) (MM5.rdC (k := 12) hlC.2.2.2.1 12 rfl) (MM5.rdC (k := 16) hlC.2.2.2.2.1 16 rfl) (by rw [MM5.size]; exact hinp) hinpU
  have RR6 := RR5.trans rr6
  obtain ⟨NN7, rr7, MM7⟩ := blk_pro6 ic0 hic G NN6 U C _ _ P MM6 len inp h3 ebp0 h4 r3 g13 (by rw [MM6.size]; exact hinp) hinpU
  have RR7 := RR6.trans rr7
  obtain ⟨NN8, rr8, MM8⟩ := blk_pro7 ic0 hic G NN7 U C _ _ P MM7 len inp h3 ebp0 h4 r3 g13 (by rw [MM7.size]; exact hinp) hinpU
  have RR8 := RR7.trans rr8
  refine ⟨NN8, _, _, g13, v12, v8, v4, RR8, MM8, ⟨(lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl), (lk_skip lk_here rfl), (lk_skip (lk_skip lk_here rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), lk_here, (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlU.1 rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlU.2.1 rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlU.2.2.1 rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl) rfl), trivial⟩, ⟨hlC.1, hlC.2.1, hlC.2.2.1, hlC.2.2.2.1, hlC.2.2.2.2.1, hlC.2.2.2.2.2.1, hlC.2.2.2.2.2.2.1, hlC.2.2.2.2.2.2.2.1, hlC.2.2.2.2.2.2.2.2.1, trivial⟩, ?_⟩
  clear rr1 rr2 rr3 rr4 rr5 rr6 rr7 rr8 RR1 RR2 RR3 RR4 RR5 RR6 RR7 RR8 MM1 MM2 MM3 MM4 MM5 MM6 MM7 MM8
  subst e_g13
  subst e_v12
  subst e_g11
  subst e_v10
  subst e_g9
  subst e_v8
  subst e_g7
  subst e_v6
  subst e_g5
  subst e_v4
  subst e_g3
  subst e_v2
  subst e_g1
  exact ⟨rfl, rfl, rfl⟩

theorem blk_epi (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (a0 c0 inp h3 b0 h4 d0 gf h0 h2 h1 r0 s3 s2 r1 s1 r2 r3 esi0 edi0 ebx0 ebp0 ret len0 pad : UInt32)
        (hlU : LK lU [(4, h0), (8, h2), (12, h1), (24, r0), (28, s3), (36, s2), (40, r1), (44, s1), (48, r2), (52, C), (56, r3), (88, esi0), (92, edi0), (96, ebx0), (100, ebp0), (104, ret), (108, len0), (112, pad)])
    (hlC : LK lC [(20, r0), (24, r1), (28, r2), (32, r3)]) :
    ∃ (N' : PMem) (lU' lC' : List (Nat × UInt32)) (g1 : UInt32),
      Run img (St.m ⟨N.get, a0, c0, inp, h3, UInt32.add U 4, b0, h4, d0, 0x10042d, efl gf, icAdd ic0 0⟩)
        (St.m ⟨N'.get, C, h2, inp, ebx0, UInt32.add U 108, ebp0, esi0, edi0, ret, efl g1, icAdd ic0 15⟩) ∧
      MemOK G N' U 116 lU' C 236 20 lC' P ∧ LK lU' [] ∧ LK lC' [(0, h0), (4, h1), (8, h2), (12, h3), (16, h4), (20, r0), (24, r1), (28, r2), (32, r3)] := by
  obtain ⟨NN1, rr1, MM1⟩ := blk_e0 ic0 hic G N U C _ _ P hM a0 c0 inp h3 b0 h4 d0 gf h0 h1 h2 (hM.rdU (k := 52) hlU.2.2.2.2.2.2.2.2.2.1 52 rfl) (hM.rdU (k := 4) hlU.1 4 rfl) (hM.rdU (k := 12) hlU.2.2.1 12 rfl) (hM.rdU (k := 8) hlU.2.1 8 rfl)
  have RR1 := rr1
  obtain ⟨NN2, rr2, MM2⟩ := blk_e1 ic0 hic G NN1 U C _ _ P MM1 h2 inp h3 b0 h4 d0 gf 
  have RR2 := RR1.trans rr2
  obtain ⟨g1, e_g1⟩ : ∃ y : UInt32, y = (addF 4 (UInt32.add U 4) 84 0).2 := ⟨_, rfl⟩
  obtain ⟨NN3, rr3, MM3⟩ := blk_e2 ic0 hic G NN2 U C _ _ P MM2 h2 inp h3 b0 h4 d0 gf g1 e_g1
  have RR3 := RR2.trans rr3
  obtain ⟨NN4, rr4, MM4⟩ := blk_e3 ic0 hic G NN3 U C _ _ P MM3 h2 inp h3 b0 h4 d0 g1 esi0 edi0 ebx0 ebp0 ret (MM3.rdU (k := 88) hlU.2.2.2.2.2.2.2.2.2.2.2.1 88 rfl) (MM3.rdU (k := 92) hlU.2.2.2.2.2.2.2.2.2.2.2.2.1 92 rfl) (MM3.rdU (k := 96) hlU.2.2.2.2.2.2.2.2.2.2.2.2.2.1 96 rfl) (MM3.rdU (k := 100) hlU.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 100 rfl) (MM3.rdU (k := 104) hlU.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 104 rfl)
  have RR4 := RR3.trans rr4
  exact ⟨NN4, _, _, g1, RR4, MM4, trivial, ⟨(lk_skip (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip lk_here rfl) rfl) rfl), (lk_skip (lk_skip lk_here rfl) rfl), (lk_skip lk_here rfl), lk_here, (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlC.1 rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlC.2.1 rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlC.2.2.1 rfl) rfl) rfl) rfl) rfl), (lk_skip (lk_skip (lk_skip (lk_skip (lk_skip hlC.2.2.2.1 rfl) rfl) rfl) rfl) rfl), trivial⟩⟩

end Solutions.OpensslPoly1305
