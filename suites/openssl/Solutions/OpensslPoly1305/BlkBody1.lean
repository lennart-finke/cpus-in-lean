import Solutions.OpensslPoly1305.Mem
/-!
# Run pieces of `poly1305_blocks` (loop body, pieces 0-5)

Generated by `gen/genblk.py` (`gen/psym.py`): each piece runs a few instructions by `cbv` from a
memory `N` described by `MemOK` (stack region `[U, U + 116)`, context `[C, C + 236)` of which the
first 20 bytes may be written), and states the values it computes as single-operation equations.
-/
namespace Solutions.OpensslPoly1305
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslPoly1305 Solutions.Exec.Mul Solutions.Exec.Fast
open Solutions.OpensslPoly1305.Cbv Solutions.Logic.Cmp

attribute [local cbv_opaque] Image.bytes
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option cbv.maxSteps 50000000
set_option exec.addrSub true
set_option autoImplicit false

/-- movl %eax, 0x50(%esp) ; movl %edx, 0x1c(%esp) ; movl %edx, %ecx ; calll 0x100068 ; movl (%ecx), %eax ; retl ; movl %eax, 0x10(%esp) ; movl 0x1c(%esp), %eax -/
theorem blk_b0 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (len c0 inp h3 b0 h4 d0 gf x1 : UInt32)
        (l_x1 : rdRaw N.get inp 4 = x1)
    (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, len, c0, inp, h3, UInt32.add U 4, b0, h4, d0, 0x100220, efl gf, icAdd ic0 0⟩)
      (St.m ⟨N'.get, inp, inp, inp, h3, UInt32.add U 4, b0, h4, d0, 0x100237, efl gf, icAdd ic0 8⟩) ∧
      MemOK G N' U 116 ((20, x1) :: (0, 1049135) :: (32, inp) :: (84, len) :: lU) C 236 20 (lC) P := by
  have M1 := hM.stU 84 84 len (by decide) rfl rfl
  have M2 := M1.stU 32 32 inp (by decide) rfl rfl
  have M3 := M2.stU0 1049135 (by decide)
  have M4 := M3.stU 20 20 x1 (by decide) rfl rfl
  refine ⟨_, run_of_runI (k := 8) ?_ (icB hic (by decide)), M4⟩
  subst l_x1
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

