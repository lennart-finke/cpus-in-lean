    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 24 lU D 16 0 lC P)
    (a0 c0 d0 ebx0 ebp0 esi0 edi0 g0 n dst g1 : UInt32)
        (l_n : rdRaw N.get (UInt32.add U 20) 4 = n)
    (l_dst : rdRaw N.get (UInt32.add U 12) 4 = dst)
    (hb0 : n.toNat = 0)
    (e_g1 : g1 = (logicF 4 n).2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, a0, c0, d0, ebx0, UInt32.add U 8, ebp0, esi0, edi0, 0x1005a0, efl g0, icAdd ic0 0⟩)
      (St.m ⟨N'.get, dst, n, d0, ebx0, U, ebp0, esi0, edi0, 0x1005cc, efl g1, icAdd ic0 6⟩) ∧
      MemOK G N' U 24 ((0, esi0) :: (4, ebx0) :: lU) D 16 0 (lC) P := by
  have M1 := hM.stU 4 4 ebx0 (by decide) rfl rfl
  have M2 := M1.stU0 esi0 (by decide)
  refine ⟨_, run_of_runI (k := 6) ?_ (icB hic (by decide)), M2⟩
  subst e_g1
