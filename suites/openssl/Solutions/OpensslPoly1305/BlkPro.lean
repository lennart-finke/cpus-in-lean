      (St.m ⟨N'.get, len, C, inp, h3, UInt32.add U 4, ebp0, h4, r3, 0x10021f, efl g13, icAdd ic0 45⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 (lC) P := by
