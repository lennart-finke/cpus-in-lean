/-- nop -/
theorem blk_pro7 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (len inp h3 ebp0 h4 r3 g13 : UInt32)
        (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, len, C, inp, h3, UInt32.add U 4, ebp0, h4, r3, 0x10021f, efl g13, icAdd ic0 45⟩)
      (St.m ⟨N'.get, len, C, inp, h3, UInt32.add U 4, ebp0, h4, r3, 0x100220, efl g13, icAdd ic0 46⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 (lC) P := by
  refine ⟨_, run_of_runI (k := 1) ?_ (icB hic (by decide)), hM⟩
