import Solutions.OpensslPoly1305.Mem
/-!
# Run pieces of `poly1305_blocks` (prologue)

Generated by `gen/genblk.py` (`gen/psym.py`): each piece runs a few instructions by `cbv` from a
memory `N` described by `MemOK` (stack region `[U, U + 116)`, context `[C, C + 236)` of which the
first 20 bytes may be written), and states the values it computes as single-operation equations.
-/
namespace Solutions.OpensslPoly1305
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslPoly1305 Solutions.Exec.Mul Solutions.Exec.Fast
open Solutions.OpensslPoly1305.Cbv Solutions.Logic.Cmp

attribute [local cbv_opaque] Image.bytes
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option cbv.maxSteps 50000000
set_option exec.addrSub true
set_option autoImplicit false

/-- pushl %ebp ; pushl %ebx ; pushl %edi ; pushl %esi -/
theorem blk_pro0 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (a0 inp ebx0 ebp0 esi0 edi0 g0 : UInt32)
        (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, a0, C, inp, ebx0, UInt32.add U 104, ebp0, esi0, edi0, 0x1001b0, efl g0, icAdd ic0 0⟩)
      (St.m ⟨N'.get, a0, C, inp, ebx0, UInt32.add U 88, ebp0, esi0, edi0, 0x1001b4, efl g0, icAdd ic0 4⟩) ∧
      MemOK G N' U 116 ((88, esi0) :: (92, edi0) :: (96, ebx0) :: (100, ebp0) :: lU) C 236 20 (lC) P := by
  have M1 := hM.stU 100 100 ebp0 (by decide) rfl rfl
  have M2 := M1.stU 96 96 ebx0 (by decide) rfl rfl
  have M3 := M2.stU 92 92 edi0 (by decide) rfl rfl
  have M4 := M3.stU 88 88 esi0 (by decide) rfl rfl
  refine ⟨_, run_of_runI (k := 4) ?_ (icB hic (by decide)), M4⟩
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- subl $0x54, %esp -/
theorem blk_pro1 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (a0 inp ebx0 ebp0 esi0 edi0 g0 g1 : UInt32)
        (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat)
    (e_g1 : g1 = (subF 4 (UInt32.add U 88) 84 0).2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, a0, C, inp, ebx0, UInt32.add U 88, ebp0, esi0, edi0, 0x1001b4, efl g0, icAdd ic0 4⟩)
      (St.m ⟨N'.get, a0, C, inp, ebx0, UInt32.add U 4, ebp0, esi0, edi0, 0x1001b7, efl g1, icAdd ic0 5⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 (lC) P := by
  refine ⟨N, ?_, hM⟩
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have h : runI img 1 (St.m ⟨N.get, a0, C, inp, ebx0, UInt32.add U 88, ebp0, esi0, edi0, 0x1001b4, efl g0, icAdd ic0 4⟩) =
      some (St.m ⟨N.get, a0, C, inp, ebx0, (subF 4 (UInt32.add U 88) 84 0).1, ebp0, esi0, edi0, 0x1001b7, efl g1, icAdd ic0 5⟩) := by
    subst e_g1
    cbv
  rw [esp_subF U 88 84 4 (by decide)] at h
  exact run_of_runI h (icB hic (by decide))

/-- movl 0x18(%ecx), %eax ; movl 0x1c(%ecx), %esi ; movl 0x20(%ecx), %edi ; movl %eax, %ebx ; shrl $0x2, %ebx ; movl %eax, 0x24(%esp) ; addl %eax, %ebx ; movl %ebx, 0x28(%esp) -/
theorem blk_pro2 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (a0 inp ebx0 ebp0 esi0 edi0 g1 r1 r2 r3 v2 g3 v4 g5 : UInt32)
        (l_r1 : rdRaw N.get (UInt32.add C 24) 4 = r1)
    (l_r2 : rdRaw N.get (UInt32.add C 28) 4 = r2)
    (l_r3 : rdRaw N.get (UInt32.add C 32) 4 = r3)
    (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat)
    (e_v2 : v2 = UInt32.shiftRight r1 2)
    (e_g3 : g3 = Solutions.Logic.Cmp.shFl 5 r1 2)
    (e_v4 : v4 = (addF 4 v2 r1 0).1)
    (e_g5 : g5 = (addF 4 v2 r1 0).2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, a0, C, inp, ebx0, UInt32.add U 4, ebp0, esi0, edi0, 0x1001b7, efl g1, icAdd ic0 5⟩)
      (St.m ⟨N'.get, r1, C, inp, v4, UInt32.add U 4, ebp0, r2, r3, 0x1001cf, efl g5, icAdd ic0 13⟩) ∧
      MemOK G N' U 116 ((44, v4) :: (40, r1) :: lU) C 236 20 (lC) P := by
  have M1 := hM.stU 40 40 r1 (by decide) rfl rfl
  have M2 := M1.stU 44 44 v4 (by decide) rfl rfl
  refine ⟨_, run_of_runI (k := 8) ?_ (icB hic (by decide)), M2⟩
  subst e_g5
  subst e_v4
  subst e_g3
  subst e_v2
  subst l_r1
  subst l_r2
  subst l_r3
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- movl %esi, %eax ; shrl $0x2, %eax ; movl %esi, 0x2c(%esp) ; addl %esi, %eax ; movl %eax, 0x20(%esp) ; movl %edi, %eax ; shrl $0x2, %eax ; movl %edi, 0x34(%esp) -/
theorem blk_pro3 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (r1 inp v4 ebp0 r2 r3 g5 v6 g7 v8 g9 v10 g11 : UInt32)
        (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat)
    (e_v6 : v6 = UInt32.shiftRight r2 2)
    (e_g7 : g7 = Solutions.Logic.Cmp.shFl 5 r2 2)
    (e_v8 : v8 = (addF 4 v6 r2 0).1)
    (e_g9 : g9 = (addF 4 v6 r2 0).2)
    (e_v10 : v10 = UInt32.shiftRight r3 2)
    (e_g11 : g11 = Solutions.Logic.Cmp.shFl 5 r3 2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, r1, C, inp, v4, UInt32.add U 4, ebp0, r2, r3, 0x1001cf, efl g5, icAdd ic0 13⟩)
      (St.m ⟨N'.get, v10, C, inp, v4, UInt32.add U 4, ebp0, r2, r3, 0x1001e7, efl g11, icAdd ic0 21⟩) ∧
      MemOK G N' U 116 ((56, r3) :: (36, v8) :: (48, r2) :: lU) C 236 20 (lC) P := by
  have M1 := hM.stU 48 48 r2 (by decide) rfl rfl
  have M2 := M1.stU 36 36 v8 (by decide) rfl rfl
  have M3 := M2.stU 56 56 r3 (by decide) rfl rfl
  refine ⟨_, run_of_runI (k := 8) ?_ (icB hic (by decide)), M3⟩
  subst e_g11
  subst e_v10
  subst e_g9
  subst e_v8
  subst e_g7
  subst e_v6
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- addl %edi, %eax ; movl %eax, 0x18(%esp) ; movl 0x68(%esp), %eax ; movl 0x14(%ecx), %esi ; movl %esi, 0x14(%esp) ; movl (%ecx), %esi ; movl %esi, (%esp) ; movl 0x4(%ecx), %esi -/
theorem blk_pro4 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (v10 inp v4 ebp0 r2 r3 g11 len r0 h0 h1 v12 g13 : UInt32)
        (l_len : rdRaw N.get (UInt32.add U 108) 4 = len)
    (l_r0 : rdRaw N.get (UInt32.add C 20) 4 = r0)
    (l_h0 : rdRaw N.get C 4 = h0)
    (l_h1 : rdRaw N.get (UInt32.add C 4) 4 = h1)
    (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat)
    (e_v12 : v12 = (addF 4 v10 r3 0).1)
    (e_g13 : g13 = (addF 4 v10 r3 0).2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, v10, C, inp, v4, UInt32.add U 4, ebp0, r2, r3, 0x1001e7, efl g11, icAdd ic0 21⟩)
      (St.m ⟨N'.get, len, C, inp, v4, UInt32.add U 4, ebp0, h1, r3, 0x100200, efl g13, icAdd ic0 29⟩) ∧
      MemOK G N' U 116 ((4, h0) :: (24, r0) :: (28, v12) :: lU) C 236 20 (lC) P := by
  have M1 := hM.stU 28 28 v12 (by decide) rfl rfl
  have M2 := M1.stU 24 24 r0 (by decide) rfl rfl
  have M3 := M2.stU 4 4 h0 (by decide) rfl rfl
  refine ⟨_, run_of_runI (k := 8) ?_ (icB hic (by decide)), M3⟩
  subst e_g13
  subst e_v12
  subst l_len
  subst l_r0
  subst l_h0
  subst l_h1
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- movl %esi, 0x8(%esp) ; movl 0x8(%ecx), %esi ; movl %esi, 0x4(%esp) ; movl 0xc(%ecx), %ebx ; movl %ecx, 0x30(%esp) ; movl 0x10(%ecx), %esi ; nop ; nop -/
theorem blk_pro5 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (len inp v4 ebp0 h1 r3 g13 h2 h3 h4 : UInt32)
        (l_h2 : rdRaw N.get (UInt32.add C 8) 4 = h2)
    (l_h3 : rdRaw N.get (UInt32.add C 12) 4 = h3)
    (l_h4 : rdRaw N.get (UInt32.add C 16) 4 = h4)
    (hinp : inp.toNat + 16 ≤ N.get.size)
    (hinpU : inp.toNat + 16 ≤ U.toNat ∨ U.toNat + 116 ≤ inp.toNat) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, len, C, inp, v4, UInt32.add U 4, ebp0, h1, r3, 0x100200, efl g13, icAdd ic0 29⟩)
      (St.m ⟨N'.get, len, C, inp, h3, UInt32.add U 4, ebp0, h4, r3, 0x100217, efl g13, icAdd ic0 37⟩) ∧
      MemOK G N' U 116 ((52, C) :: (8, h2) :: (12, h1) :: lU) C 236 20 (lC) P := by
  have M1 := hM.stU 12 12 h1 (by decide) rfl rfl
  have M2 := M1.stU 8 8 h2 (by decide) rfl rfl
  have M3 := M2.stU 52 52 C (by decide) rfl rfl
  refine ⟨_, run_of_runI (k := 8) ?_ (icB hic (by decide)), M3⟩
  subst l_h2
  subst l_h3
  subst l_h4
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- nop ; nop ; nop ; nop ; nop ; nop ; nop ; nop -/
theorem blk_pro6 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (len inp h3 ebp0 h4 r3 g13 : UInt32)
