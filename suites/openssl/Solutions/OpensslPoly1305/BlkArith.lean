import Ssl.Spec.Poly1305
/-!
# The arithmetic of one block of `poly1305_blocks`

`blk_arith`: from the natural-number equations of the values the code computes for one block
(statement generated by `gen/genmath.py`), the new limbs keep `h4 ≤ 4` and represent
`(h + m + pad·2^128) · r` modulo `p = 2^130 - 5`. The steps: the sum `h + m` with carries (`stepA`),
four 64-bit sums of products (`sum4`), the partial reduction by `2^130 ≡ 5` (`ring_id`), the carry
propagation of `(h4 >> 2)·5` (`stepC`).
-/
namespace Solutions.OpensslPoly1305
open Ssl.Spec.Poly1305

theorem p_val : p = 2 ^ 130 - 5 := rfl

/-- A 64-bit sum of four products, as the code adds them (low words, then high words with carries). -/
theorem sum4 {l1 h1 l2 h2 l3 h3 l4 h4 s1 c1 t1 c2 s2 c3 t2 c4 s3 c5 t3 c6 P1 P2 P3 P4 : Nat}
    (bh2 : h2 < 2 ^ 32) (bh3 : h3 < 2 ^ 32) (bh4 : h4 < 2 ^ 32)
    (bs1 : s1 < 2 ^ 32) (bt1 : t1 < 2 ^ 32) (bs2 : s2 < 2 ^ 32) (bt2 : t2 < 2 ^ 32) (bs3 : s3 < 2 ^ 32)
    (bt3 : t3 < 2 ^ 32) (bc1 : c1 ≤ 1) (bc2 : c2 ≤ 1) (bc3 : c3 ≤ 1) (bc4 : c4 ≤ 1) (bc5 : c5 ≤ 1)
    (bc6 : c6 ≤ 1)
    (e1 : l1 + 2 ^ 32 * h1 = P1) (e2 : l2 + 2 ^ 32 * h2 = P2) (e3 : s1 + 2 ^ 32 * c1 = l2 + l1 + 0)
    (e4 : t1 + 2 ^ 32 * c2 = h2 + h1 + c1) (e5 : l3 + 2 ^ 32 * h3 = P3) (e6 : s2 + 2 ^ 32 * c3 = l3 + s1 + 0)
    (e7 : t2 + 2 ^ 32 * c4 = h3 + t1 + c3) (e8 : l4 + 2 ^ 32 * h4 = P4) (e9 : s3 + 2 ^ 32 * c5 = l4 + s2 + 0)
    (e10 : t3 + 2 ^ 32 * c6 = h4 + t2 + c5) (hb : P1 + P2 + P3 + P4 < 2 ^ 64) :
    s3 + 2 ^ 32 * t3 = P1 + P2 + P3 + P4 := by
  omega

theorem ring_id (a0 a1 a2 a3 a4 r0 q1 q2 q3 : Nat) :
    (a0 + 2 ^ 32 * a1 + 2 ^ 64 * a2 + 2 ^ 96 * a3 + 2 ^ 128 * a4) *
      (r0 + 2 ^ 32 * (4 * q1) + 2 ^ 64 * (4 * q2) + 2 ^ 96 * (4 * q3)) =
    (a0 * r0 + a1 * (5 * q3) + a2 * (5 * q2) + a3 * (5 * q1)) +
      2 ^ 32 * (a0 * (4 * q1) + a1 * r0 + a2 * (5 * q3) + a3 * (5 * q2) + a4 * (5 * q1)) +
      2 ^ 64 * (a0 * (4 * q2) + a1 * (4 * q1) + a2 * r0 + a3 * (5 * q3) + a4 * (5 * q2)) +
      2 ^ 96 * (a0 * (4 * q3) + a1 * (4 * q2) + a2 * (4 * q1) + a3 * r0 + a4 * (5 * q3)) +
      2 ^ 128 * (a4 * r0) +
      (2 ^ 130 - 5) * ((a1 * q3 + a2 * q2 + a3 * q1) + 2 ^ 32 * (a2 * q3 + a3 * q2 + a4 * q1) +
        2 ^ 64 * (a3 * q3 + a4 * q2) + 2 ^ 96 * (a4 * q3)) := by
  grind

theorem mul_lt {a b A B : Nat} (ha : a < A) (hb : b < B) : a * b < A * B := Nat.mul_lt_mul'' ha hb

theorem mul_le' {a b A B : Nat} (ha : a ≤ A) (hb : b ≤ B) : a * b ≤ A * B := Nat.mul_le_mul ha hb

theorem carry_lin {v c a b : Nat} (hv : v = (a + b) % 2 ^ 32) (hc : c = if 2 ^ 32 ≤ a + b then 1 else 0)
    (ha : a < 2 ^ 32) (hb : b < 2 ^ 32) : v + 2 ^ 32 * c = a + b := by
  subst hv hc; split <;> omega

