    (b_v5 : v5 < 2 ^ 32) (b_v7 : v7 < 2 ^ 32) (b_v9 : v9 < 2 ^ 32) (b_v11 : v11 < 2 ^ 32) (b_v13 : v13 < 2 ^ 32)
    (b_c6 : c6 ≤ 1) (b_c8 : c8 ≤ 1) (b_c10 : c10 ≤ 1) (b_c12 : c12 ≤ 1) (b_c14 : c14 ≤ 1)
    (f_v5 : v5 + 2 ^ 32 * c6 = x1 + h0 + 0) (f_v7 : v7 + 2 ^ 32 * c8 = x2 + h1 + c6)
    (f_v9 : v9 + 2 ^ 32 * c10 = x3 + h2 + c8) (f_v11 : v11 + 2 ^ 32 * c12 = x4 + h3 + c10)
    (f_v13 : v13 + 2 ^ 32 * c14 = h4 + pad + c12) (hh4 : h4 ≤ 4) (hpad : pad ≤ 1) :
    v13 ≤ 6 ∧ v5 + 2 ^ 32 * v7 + 2 ^ 64 * v9 + 2 ^ 96 * v11 + 2 ^ 128 * v13 =
      (h0 + 2 ^ 32 * h1 + 2 ^ 64 * h2 + 2 ^ 96 * h3 + 2 ^ 128 * h4) +
      (x1 + 2 ^ 32 * x2 + 2 ^ 64 * x3 + 2 ^ 96 * x4) + 2 ^ 128 * pad :=
  ⟨by omega, by omega⟩

