import Solutions.OpensslPoly1305.Mem
/-!
# Run pieces of `poly1305_blocks` (loop branch and epilogue)

Generated by `gen/genblk.py` (`gen/psym.py`): each piece runs a few instructions by `cbv` from a
memory `N` described by `MemOK` (stack region `[U, U + 116)`, context `[C, C + 236)` of which the
first 20 bytes may be written), and states the values it computes as single-operation equations.
-/
namespace Solutions.OpensslPoly1305
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslPoly1305 Solutions.Exec.Mul Solutions.Exec.Fast
open Solutions.OpensslPoly1305.Cbv Solutions.Logic.Cmp

attribute [local cbv_opaque] Image.bytes
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option cbv.maxSteps 50000000
set_option exec.addrSub true
set_option autoImplicit false

/-- cmpl $0xf, %eax ; ja 0x100220 -/
theorem blk_jt (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (len c0 inp h3 b0 h4 d0 gf g1 : UInt32)
        (hb0 : 15 < len.toNat)
    (e_g1 : g1 = (subF 4 len 15 0).2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, len, c0, inp, h3, UInt32.add U 4, b0, h4, d0, 0x100424, efl gf, icAdd ic0 0⟩)
      (St.m ⟨N'.get, len, c0, inp, h3, UInt32.add U 4, b0, h4, d0, 0x100220, efl g1, icAdd ic0 2⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 (lC) P := by
  refine ⟨_, run_of_runI (k := 2) ?_ (icB hic (by decide)), hM⟩
  subst e_g1
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- cmpl $0xf, %eax ; ja 0x100220 -/
theorem blk_jn (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (len c0 inp h3 b0 h4 d0 gf g1 : UInt32)
        (hb0 : len.toNat = 0)
    (e_g1 : g1 = (subF 4 len 15 0).2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, len, c0, inp, h3, UInt32.add U 4, b0, h4, d0, 0x100424, efl gf, icAdd ic0 0⟩)
      (St.m ⟨N'.get, len, c0, inp, h3, UInt32.add U 4, b0, h4, d0, 0x10042d, efl g1, icAdd ic0 2⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 (lC) P := by
  refine ⟨_, run_of_runI (k := 2) ?_ (icB hic (by decide)), hM⟩
  subst e_g1
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- movl 0x30(%esp), %eax ; movl (%esp), %ecx ; movl %ecx, (%eax) ; movl 0x8(%esp), %ecx ; movl %ecx, 0x4(%eax) ; movl 0x4(%esp), %ecx ; movl %ecx, 0x8(%eax) ; movl %ebx, 0xc(%eax) -/
theorem blk_e0 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (a0 c0 inp h3 b0 h4 d0 gf h0 h1 h2 : UInt32)
        (l_C : rdRaw N.get (UInt32.add U 52) 4 = C)
    (l_h0 : rdRaw N.get (UInt32.add U 4) 4 = h0)
    (l_h1 : rdRaw N.get (UInt32.add U 12) 4 = h1)
    (l_h2 : rdRaw N.get (UInt32.add U 8) 4 = h2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, a0, c0, inp, h3, UInt32.add U 4, b0, h4, d0, 0x10042d, efl gf, icAdd ic0 0⟩)
      (St.m ⟨N'.get, C, h2, inp, h3, UInt32.add U 4, b0, h4, d0, 0x100447, efl gf, icAdd ic0 8⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 ((12, h3) :: (8, h2) :: (4, h1) :: (0, h0) :: lC) P := by
  have M1 := hM.stC0 h0 (by decide) (by decide)
  have M2 := M1.stC 4 4 h1 (by decide) rfl rfl (by decide)
  have M3 := M2.stC 8 8 h2 (by decide) rfl rfl (by decide)
  have M4 := M3.stC 12 12 h3 (by decide) rfl rfl (by decide)
  refine ⟨_, run_of_runI (k := 8) ?_ (icB hic (by decide)), M4⟩
  subst l_C
  subst l_h0
  subst l_h1
  subst l_h2
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- movl %esi, 0x10(%eax) -/
theorem blk_e1 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (h2 inp h3 b0 h4 d0 gf : UInt32)
     :
    ∃ N' : PMem, Run img (St.m ⟨N.get, C, h2, inp, h3, UInt32.add U 4, b0, h4, d0, 0x100447, efl gf, icAdd ic0 8⟩)
      (St.m ⟨N'.get, C, h2, inp, h3, UInt32.add U 4, b0, h4, d0, 0x10044a, efl gf, icAdd ic0 9⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 ((16, h4) :: lC) P := by
  have M1 := hM.stC 16 16 h4 (by decide) rfl rfl (by decide)
  refine ⟨_, run_of_runI (k := 1) ?_ (icB hic (by decide)), M1⟩
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

/-- addl $0x54, %esp -/
theorem blk_e2 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (h2 inp h3 b0 h4 d0 gf g1 : UInt32)
        (e_g1 : g1 = (addF 4 (UInt32.add U 4) 84 0).2) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, C, h2, inp, h3, UInt32.add U 4, b0, h4, d0, 0x10044a, efl gf, icAdd ic0 9⟩)
      (St.m ⟨N'.get, C, h2, inp, h3, UInt32.add U 88, b0, h4, d0, 0x10044d, efl g1, icAdd ic0 10⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 (lC) P := by
  refine ⟨N, ?_, hM⟩
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have h : runI img 1 (St.m ⟨N.get, C, h2, inp, h3, UInt32.add U 4, b0, h4, d0, 0x10044a, efl gf, icAdd ic0 9⟩) =
      some (St.m ⟨N.get, C, h2, inp, h3, (addF 4 (UInt32.add U 4) 84 0).1, b0, h4, d0, 0x10044d, efl g1, icAdd ic0 10⟩) := by
    subst e_g1
    cbv
  rw [esp_addF U 4 84 88 (by decide)] at h
  exact run_of_runI h (icB hic (by decide))

/-- popl %esi ; popl %edi ; popl %ebx ; popl %ebp ; retl -/
theorem blk_e3 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : PMem) (U C : UInt32)
    (lU lC : List (Nat × UInt32)) (P : Nat → Prop) (hM : MemOK G N U 116 lU C 236 20 lC P)
    (h2 inp h3 b0 h4 d0 g1 esi0 edi0 ebx0 ebp0 ret : UInt32)
        (l_esi0 : rdRaw N.get (UInt32.add U 88) 4 = esi0)
    (l_edi0 : rdRaw N.get (UInt32.add U 92) 4 = edi0)
    (l_ebx0 : rdRaw N.get (UInt32.add U 96) 4 = ebx0)
    (l_ebp0 : rdRaw N.get (UInt32.add U 100) 4 = ebp0)
    (l_ret : rdRaw N.get (UInt32.add U 104) 4 = ret) :
    ∃ N' : PMem, Run img (St.m ⟨N.get, C, h2, inp, h3, UInt32.add U 88, b0, h4, d0, 0x10044d, efl g1, icAdd ic0 10⟩)
      (St.m ⟨N'.get, C, h2, inp, ebx0, UInt32.add U 108, ebp0, esi0, edi0, ret, efl g1, icAdd ic0 15⟩) ∧
      MemOK G N' U 116 (lU) C 236 20 (lC) P := by
  refine ⟨_, run_of_runI (k := 5) ?_ (icB hic (by decide)), hM⟩
  subst l_esi0
  subst l_edi0
  subst l_ebx0
  subst l_ebp0
  subst l_ret
  have q1 := hM.fU.top; have q2 := hM.fU.fit; have q3 := hM.fU.img
  have q4 := hM.fC.fit; have q5 := hM.fC.img; have q6 := hM.dUC
  cbv

end Solutions.OpensslPoly1305
