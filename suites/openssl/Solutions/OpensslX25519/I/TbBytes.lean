/-!
# `fe_tobytes`: the output bytes

Generated by `gen/gentbmain.py` (prover Q). `tbb<j>`: byte `j` that `fe_tobytes` stores, as a function of
the ten chain words (`t0 … t9`, as natural numbers), is byte `j` of `tbVN t0 … t9`. Also the helpers of
the call contract (`I/TbCall`): byte stores into the output keep the frame (`Frame.wrO1`), the bytes
written so far (`bytes_step`), the final list (`bytes_final`).
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Solutions.OpensslX25519 Ssl.OpensslX25519

def tbVN (t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 : Nat) : Nat :=
  t0 % 2 ^ 26 + 2 ^ 26 * (t1 % 2 ^ 25) + 2 ^ 51 * (t2 % 2 ^ 26) + 2 ^ 77 * (t3 % 2 ^ 25) +
    2 ^ 102 * (t4 % 2 ^ 26) + 2 ^ 128 * (t5 % 2 ^ 25) + 2 ^ 153 * (t6 % 2 ^ 26) +
    2 ^ 179 * (t7 % 2 ^ 25) + 2 ^ 204 * (t8 % 2 ^ 26) + 2 ^ 230 * (t9 % 2 ^ 25)

theorem mod_shl_zero (t k : Nat) (hk : k ≤ 32) : t * 2 ^ k % 2 ^ 32 % 2 ^ k = 0 := by
  rw [Nat.mod_mod_of_dvd _ (Nat.pow_dvd_pow 2 hk), Nat.mul_mod_left]

/-- Outside the 32 output bytes at `out`. -/
def OutO (out : UInt32) (x : Nat) : Prop := x < out.toNat ∨ out.toNat + 32 ≤ x

theorem ok1_of (N : XMem) (a out : UInt32) (o : Nat) (ha : a.toNat = out.toNat + o) (ho : o < 32)
    (hs : out.toNat + 32 ≤ N.get.size) (hoi : out.toNat + 32 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ out.toNat) :
    StoreOk1 Image.base Image.size N.mem a :=
  ⟨by show a.toNat < N.get.size; omega,
   by rw [show Image.base.toNat = 0x100000 from rfl, show Image.size = 47024 from rfl]; omega⟩

theorem _root_.Solutions.OpensslX25519.Frame.wrO1 {N : XMem} {b : UInt32} {n : Nat} {l : List (Nat × UInt32)}
    (hF : Frame N b n l) (h : FB N.get.size b n) {a v : UInt32} (ok : StoreOk1 Image.base Image.size N.mem a)
    (hd : a.toNat < b.toNat ∨ b.toNat + n ≤ a.toNat) : Frame (CodeMem.wr1 N a v ok) b n l :=
  hF.pres h ((Pres.refl N (fun x => b.toNat ≤ x ∧ x < b.toNat + n)).wr1 ok (fun x hx => by omega))
    (fun x h1 h2 => ⟨h1, h2⟩)

theorem bytes_step (N : XMem) (out a v : UInt32) (ok : StoreOk1 Image.base Image.size N.mem a) (V k : Nat)
    (ha : a.toNat = out.toNat + k) (hk : k < 32) (hs : out.toNat + 32 ≤ N.get.size) (htop : N.get.size ≤ ramTop)
    (H : ∀ i, i < k → memByte N.get (out + i.toUInt32) = tbB V i) (hv : v.toUInt8 = tbB V k) :
    ∀ i, i < k + 1 → memByte (CodeMem.wr1 N a v ok).get (out + i.toUInt32) = tbB V i := by
  intro i hi
  have hT : N.get.size < 2 ^ 32 := by unfold ramTop at htop; omega
  have ei : (out + i.toUInt32).toNat = out.toNat + i := by
    rw [UInt32.toNat_add, Nat.toUInt32, UInt32.toNat_ofNat']; omega
  by_cases h : i = k
  · subst h
    have e : out + i.toUInt32 = a := UInt32.toNat_inj.1 (by rw [ei, ha])
    rw [e, memByte_wr1_self]; exact hv
  · rw [memByte_wr1_other N a v ok (by rw [ei]; omega) (by rw [ei, ha]; omega)]
    exact H i (by omega)

theorem bytes_final (N : XMem) (out : UInt32) (V : Nat)
    (B : ∀ i, i < 32 → memByte N.get (out + i.toUInt32) = tbB V i) :
    memBytes N.get out 32 = Ssl.Spec.X25519.leBytes 32 V := by
  unfold memBytes Ssl.Spec.X25519.leBytes
  apply List.map_congr_left
  intro i hi
  rw [List.mem_range] at hi
  rw [B i hi]
  rfl

theorem inM_of_mulOut {v : Array UInt32} (h : MulOut v) : InM (lift v) := by
  have b0 := h.2 0 (by decide)
  have b1 := h.2 1 (by decide)
  have b2 := h.2 2 (by decide)
  have b3 := h.2 3 (by decide)
  have b4 := h.2 4 (by decide)
  have b5 := h.2 5 (by decide)
  have b6 := h.2 6 (by decide)
  have b7 := h.2 7 (by decide)
  have b8 := h.2 8 (by decide)
  have b9 := h.2 9 (by decide)
  simp only [Nat.reduceMod, Nat.reduceSub, Nat.reducePow, Nat.reduceMul] at b0 b1 b2 b3 b4 b5 b6 b7 b8 b9
  simp only [InM, lift]
  omega

