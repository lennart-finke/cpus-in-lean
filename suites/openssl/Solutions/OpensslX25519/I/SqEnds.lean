/-! (Call-level copy at any instruction count, generated by gen/icall.py.)
# The run of `fe_sq`: prologue, output stores, epilogue

The pieces of the run of `fe_sq` around its body (`SqRun*`): the four pushes and the frame
allocation, the ten stores into the output buffer `hp` (loaded from the frame), and the frame
release, the four pops and the return. The stack pointer after `subl $0x1c0, %esp` and after
`addl $0x1c0, %esp` is rewritten to `fb` and `fb + 448`.
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519 Solutions.Exec.Mul Solutions.Exec.Fast

attribute [local cbv_opaque] Image.bytes
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option cbv.maxSteps 50000000

set_option exec.addrSub true in
/-- `pushl %ebp ; pushl %ebx ; pushl %edi ; pushl %esi` -/
theorem sq_pro (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G : XMem) (fb : UInt32) (hS : FB G.get.size fb 468) (l : List (Nat × UInt32))
    (hF : Frame G fb 468 l) (eax ecx edx ebx ebp esi edi f : UInt32) :
    ∃ N' : XMem, Run img (St.m ⟨G.get, eax, ecx, edx, ebx, UInt32.add fb 464, ebp, esi, edi, 0x102360, efl f, icAdd ic0 0⟩)
      (St.m ⟨N'.get, eax, ecx, edx, ebx, UInt32.add fb 448, ebp, esi, edi, 0x102364, efl f, icAdd ic0 4⟩) ∧
      Frame N' fb 468 ((448, esi) :: (452, edi) :: (456, ebx) :: (460, ebp) :: l) ∧
      Pres G N' (OutF fb 464) := by
  refine ⟨stF (stF (stF (stF G fb 468 460 ebp hS (by decide)) fb 468 456 ebx stF_FB (by decide))
    fb 468 452 edi stF_FB (by decide)) fb 468 448 esi stF_FB (by decide), run_of_runI (k := 4) ?_ (icB hic (by decide)),
    (((hF.wrF 460 rfl rfl).wrF 456 rfl rfl).wrF 452 rfl rfl).wrF 448 rfl rfl,
    ((((Pres.refl G _).wrF (by decide)).wrF (by decide)).wrF (by decide)).wrF (by decide)⟩
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  clear hF
  cbv

theorem esp_sub (fb : UInt32) : (subF 4 (UInt32.add fb 448) 448 0).1 = fb := by
  rw [subF_fst]; show fb + 448 - 448 = fb; exact UInt32.add_sub_cancel _ _

/-- `subl $0x1c0, %esp` -/
theorem sq_sub (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (N : XMem) (fb : UInt32) (hS : FB N.get.size fb 468) (eax ecx edx ebx ebp esi edi f : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add fb 448, ebp, esi, edi, 0x102364, efl f, icAdd ic0 4⟩)
      (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, esi, edi, 0x10236a, efl (subF 4 (UInt32.add fb 448) 448 0).2, icAdd ic0 5⟩) := by
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  have h : runI img 1 (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add fb 448, ebp, esi, edi, 0x102364, efl f, icAdd ic0 4⟩) =
      some (St.m ⟨N.get, eax, ecx, edx, ebx, (subF 4 (UInt32.add fb 448) 448 0).1, ebp, esi, edi, 0x10236a,
        efl (subF 4 (UInt32.add fb 448) 448 0).2, icAdd ic0 5⟩) := by
    cbv
  rw [esp_sub] at h
  exact run_of_runI h (icB hic (by decide))

/-- `movl 0x1bc(%esp), %esi`: the output pointer. -/
theorem sq_ld (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (N : XMem) (fb : UInt32) (hS : FB N.get.size fb 468) (eax ecx edx ebx ebp esi edi f : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, esi, edi, 0x102c87, efl f, icAdd ic0 552⟩)
      (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, rdRaw N.get (UInt32.add fb 444) 4, edi, 0x102c8e, efl f, icAdd ic0 553⟩) := by
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  refine run_of_runI (k := 1) ?_ (icB hic (by decide))
  cbv

/-- `movl %eax, (%esi) ; movl %edx, 0x4(%esi) ; movl 0x1c(%esp), %eax ; movl %eax, 0x8(%esi) ;
movl 0x8(%esp), %eax ; movl %eax, 0xc(%esi)` -/
theorem sq_o1 (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (G N : XMem) (fb hp : UInt32) (hS : FB N.get.size fb 468) (hH : FB N.get.size hp 40)
    (hd : hp.toNat + 40 ≤ fb.toNat ∨ fb.toNat + 468 ≤ hp.toNat) (l lh : List (Nat × UInt32))
    (hF : Frame N fb 468 l) (hFH : Frame N hp 40 lh) (hP : Pres G N (OutH fb 464 hp))
    (eax ecx edx ebx ebp edi f w2 w3 : UInt32) (l2 : l.lookup 28 = some w2) (l3 : l.lookup 8 = some w3) :
    ∃ N' : XMem, Run img (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, hp, edi, 0x102c8e, efl f, icAdd ic0 553⟩)
      (St.m ⟨N'.get, w3, ecx, edx, ebx, fb, ebp, hp, edi, 0x102ca1, efl f, icAdd ic0 559⟩) ∧
      Frame N' fb 468 l ∧ Frame N' hp 40 ((12, w3) :: (8, w2) :: (4, edx) :: (0, eax) :: lh) ∧
      Pres G N' (OutH fb 464 hp) := by
  refine ⟨stF (stF (stF (stF0 N hp 40 eax hH (by decide)) hp 40 4 edx stF0_FB (by decide)) hp 40 8 w2 stF_FB
    (by decide)) hp 40 12 w3 stF_FB (by decide), run_of_runI (k := 6) ?_ (icB hic (by decide)),
    (((hF.wrH0 hS hd).wrH (hS.size_eq (by simp only [stF_size, stF0_size])) hd).wrH
      (hS.size_eq (by simp only [stF_size, stF0_size])) hd).wrH (hS.size_eq (by simp only [stF_size, stF0_size])) hd,
    ((hFH.wrF0).wrF 4 rfl rfl |>.wrF 8 rfl rfl).wrF 12 rfl rfl,
    ((hP.wrH0).wrH.wrH).wrH⟩
  have r2 := hF.rd l2 28 rfl; have r3 := hF.rd l3 8 rfl
  subst r2 r3
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img; have h4 := hH.fit; have h5 := hH.img
  clear hF hFH hP
  cbv

