import Solutions.OpensslX25519.I.CswapRun
import Solutions.OpensslX25519.Peel
/-!
# `fe_cswap` as a callee

Generated by gen/gencswap.py. `fe_cswap(f, g, b)` with `b ∈ {0, 1}` and `f`, `g` apart swaps the
two limb vectors if `b = 1` and leaves them if `b = 0`; it writes only `f`, `g` and its 8 stack bytes.
The run is put together from the pieces of `CswapRun`; the words of `f`, `g` and the frame are
tracked as `Frame`s.
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519

/-- The address facts of a call of `fe_cswap` at `sp` (window 8 bytes, `b` at `sp + 4`). -/
structure CswapFacts (size sp f g : Nat) : Prop where
  ram : size ≤ ramTop
  sp_lo : 8 ≤ sp
  sp_hi : sp + 8 ≤ size
  sp_img : sp + 8 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ sp - 8
  f_mem : f + 40 ≤ size
  g_mem : g + 40 ≤ size
  f_img : f + 40 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ f
  g_img : g + 40 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ g
  f_stk : f + 40 ≤ sp - 8 ∨ sp + 8 ≤ f
  g_stk : g + 40 ≤ sp - 8 ∨ sp + 8 ≤ g
  fg : f + 40 ≤ g ∨ g + 40 ≤ f

theorem csM_eq (a b : UInt32) : csM a b = 0 - b := by
  unfold csM; rw [subF_fst]; show (a ^^^ a) - b = 0 - b; rw [UInt32.xor_self]

theorem csF_eq (x y m : UInt32) : csF x y m = x ^^^ ((y ^^^ x) &&& m) := rfl
theorem csG_eq (x y m : UInt32) : csG x y m = y ^^^ ((y ^^^ x) &&& m) := rfl

theorem cs_sem (x y a b : UInt32) (hb : b = 0 ∨ b = 1) :
    csF x y (csM a b) = (if b = 1 then y else x) ∧ csG x y (csM a b) = (if b = 1 then x else y) := by
  rw [csF_eq, csG_eq, csM_eq]
  rcases hb with rfl | rfl
  · simp
  · refine ⟨?_, ?_⟩ <;> apply UInt32.toBitVec_inj.1 <;> simp <;> ext i <;> simp <;> cases x.toBitVec[i] <;>
      cases y.toBitVec[i] <;> simp

theorem _root_.Solutions.OpensslX25519.Frame.cons {N : XMem} {b : UInt32} {n : Nat} {l : List (Nat × UInt32)} (hF : Frame N b n l)
    (k : Nat) (w : UInt32) (h4 : k % 4 = 0) (hk : k + 4 ≤ n) (hr : rdRaw N.get (UInt32.add b k.toUInt32) 4 = w) :
    Frame N b n ((k, w) :: l) := by
  intro k' w' hl
  rw [lookup_cons] at hl
  split at hl
  · rename_i hkk; subst hkk; simp only [Option.some.injEq] at hl; subst hl; exact ⟨h4, hk, hr⟩
  · exact hF k' w' hl

theorem frame10 (G : XMem) (p : UInt32) (v : Array UInt32) (hv : memWords G.get p 10 = v) :
    Frame G p 40 [(0, v[0]!), (4, v[1]!), (8, v[2]!), (12, v[3]!), (16, v[4]!), (20, v[5]!), (24, v[6]!),
      (28, v[7]!), (32, v[8]!), (36, v[9]!)] := by
  have r : ∀ i, i < 10 → rdRaw G.get (UInt32.add p (4 * i).toUInt32) 4 = v[i]! := fun i hi => by
    rw [← hv, memWords_getElem! _ _ _ _ hi]
    first | rfl | (congr 2; apply UInt32.toNat_inj.1; simp) | (congr 2; apply UInt32.toNat_inj.1; simp; omega)
  have F := Frame.nil G p 40
  have F := Frame.cons F 36 _ rfl (by decide) (r 9 (by decide))
  have F := Frame.cons F 32 _ rfl (by decide) (r 8 (by decide))
  have F := Frame.cons F 28 _ rfl (by decide) (r 7 (by decide))
  have F := Frame.cons F 24 _ rfl (by decide) (r 6 (by decide))
  have F := Frame.cons F 20 _ rfl (by decide) (r 5 (by decide))
  have F := Frame.cons F 16 _ rfl (by decide) (r 4 (by decide))
  have F := Frame.cons F 12 _ rfl (by decide) (r 3 (by decide))
  have F := Frame.cons F 8 _ rfl (by decide) (r 2 (by decide))
  have F := Frame.cons F 4 _ rfl (by decide) (r 1 (by decide))
  have F := Frame.cons F 0 _ rfl (by decide) (r 0 (by decide))
  exact F

/-- A store into the region `[c, c + m)` keeps the words of a region apart from it. -/
theorem _root_.Solutions.OpensslX25519.Frame.wrX {N : XMem} {b : UInt32} {n : Nat} {l : List (Nat × UInt32)} (hF : Frame N b n l)
    (hS : FB N.get.size b n) {c j v : UInt32} {m : Nat} {h : FB N.get.size c m} {hj : j.toNat + 4 ≤ m}
    (hd : c.toNat + m ≤ b.toNat ∨ b.toNat + n ≤ c.toNat) : Frame (stF N c m j v h hj) b n l :=
  hF.wr_other hS _ (by have := h.add_toNat (j := j) (by omega); omega)

theorem _root_.Solutions.OpensslX25519.Frame.wrX0 {N : XMem} {b : UInt32} {n : Nat} {l : List (Nat × UInt32)} (hF : Frame N b n l)
    (hS : FB N.get.size b n) {c v : UInt32} {m : Nat} {h : FB N.get.size c m} {hm : 4 ≤ m}
    (hd : c.toNat + m ≤ b.toNat ∨ b.toNat + n ≤ c.toNat) : Frame (stF0 N c m v h hm) b n l :=
  hF.wr_other hS _ (by omega)

theorem _root_.Solutions.OpensslX25519.Pres.wrB {G N : XMem} {P : Nat → Prop} (hP : Pres G N P) {c j v : UInt32} {m : Nat}
    {h : FB N.get.size c m} {hj : j.toNat + 4 ≤ m} (hd : ∀ x, P x → x < c.toNat ∨ c.toNat + m ≤ x) :
    Pres G (stF N c m j v h hj) P :=
  hP.wr _ (fun x hx => by have := h.add_toNat (j := j) (by omega); have := hd x hx; omega)

theorem _root_.Solutions.OpensslX25519.Pres.wrB0 {G N : XMem} {P : Nat → Prop} (hP : Pres G N P) {c v : UInt32} {m : Nat}
    {h : FB N.get.size c m} {hm : 4 ≤ m} (hd : ∀ x, P x → x < c.toNat ∨ c.toNat + m ≤ x) :
    Pres G (stF0 N c m v h hm) P :=
  hP.wr _ (fun x hx => by have := hd x hx; omega)

theorem _root_.Solutions.OpensslX25519.Pres.wrS {G N : XMem} {P : Nat → Prop} (hP : Pres G N P) {c j v : UInt32} {m : Nat}
    {h : FB N.get.size c m} {hj : j.toNat + 4 ≤ m} (k : Nat) (hk : j.toNat = k)
    (hd : ∀ x, P x → x < c.toNat + k ∨ c.toNat + k + 4 ≤ x) : Pres G (stF N c m j v h hj) P :=
  hP.wr _ (fun x hx => by have := h.add_toNat (j := j) (by omega); have := hd x hx; omega)

theorem _root_.Solutions.OpensslX25519.Pres.wrS0 {G N : XMem} {P : Nat → Prop} (hP : Pres G N P) {c v : UInt32} {m : Nat}
    {h : FB N.get.size c m} {hm : 4 ≤ m} (hd : ∀ x, P x → x < c.toNat ∨ c.toNat + 4 ≤ x) :
    Pres G (stF0 N c m v h hm) P :=
  hP.wr _ (fun x hx => hd x hx)

theorem memWords_frame {N : XMem} {p : UInt32} {l : List (Nat × UInt32)} (hF : Frame N p 40 l)
    (w : Nat → UInt32) (h : ∀ i, i < 10 → l.lookup (4 * i) = some (w i)) :
    memWords N.get p 10 = Array.ofFn (n := 10) fun i => w i.val := by
  apply Array.ext
  · simp [memWords]
  · intro i h1 h2
    simp only [memWords, Array.getElem_ofFn, memWord]
    have hi : i < 10 := by simpa [memWords] using h1
    have := hF.rd (h i hi) (4 * i.toUInt32) (by simp; omega)
    exact this

theorem ofFn_sel (fv gv : Array UInt32) (hf : fv.size = 10) (hg : gv.size = 10) (c : Prop) [Decidable c] :
    (Array.ofFn (n := 10) fun i => if c then gv[i.val]! else fv[i.val]!) = if c then gv else fv := by
  split
  · apply Array.ext
    · simp [hg]
    · intro i h1 h2; simp at h1; simp [Array.getElem_ofFn, getElem!_pos gv i (by omega)]
  · apply Array.ext
    · simp [hf]
    · intro i h1 h2; simp at h1; simp [Array.getElem_ofFn, getElem!_pos fv i (by omega)]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem fe_cswap_call (G : XMem) (sp fp gp ret b : UInt32) (fv gv : Array UInt32)
    (F : CswapFacts G.get.size sp.toNat fp.toNat gp.toNat) (hret0 : rdRaw G.get sp 4 = ret)
    (hb0 : rdRaw G.get (sp + 4) 4 = b) (hb : b = 0 ∨ b = 1)
    (hfv : memWords G.get fp 10 = fv) (hgv : memWords G.get gp 10 = gv)
    (a0 ebx0 ebp0 esi0 edi0 fl0 : UInt32) (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) :
    ∃ (N : XMem) (eax ecx edx fl : UInt32),
      Run img (St.m ⟨G.get, a0, fp, gp, ebx0, sp, ebp0, esi0, edi0, 0x103b40, efl fl0, ic0⟩)
        (St.m ⟨N.get, eax, ecx, edx, ebx0, sp + 4, ebp0, esi0, edi0, ret, efl fl, icAdd ic0 77⟩) ∧
      Pres G N (fun x => OutF (sp - 8) 8 x ∧ (x < fp.toNat ∨ fp.toNat + 40 ≤ x) ∧
        (x < gp.toNat ∨ gp.toNat + 40 ≤ x)) ∧
      memWords N.get fp 10 = (if b = 1 then gv else fv) ∧ memWords N.get gp 10 = (if b = 1 then fv else gv) := by
  have hfs : fv.size = 10 := by rw [← hfv]; simp [memWords]
  have hgs : gv.size = 10 := by rw [← hgv]; simp [memWords]
  obtain ⟨fb, hfb⟩ : ∃ fb : UInt32, fb = sp - 8 := ⟨_, rfl⟩
  have hfbN : fb.toNat = sp.toNat - 8 := by rw [hfb]; exact fb_toNatW (W := 8) F.sp_lo 8 (Nat.le_refl _)
  have hspfb : sp = UInt32.add fb 8 := by
    apply UInt32.toNat_inj.1
    rw [toNat_uadd, hfbN]
    have := F.sp_lo; have := sp.toNat_lt
    simp only [UInt32.reduceToNat]; omega
  have hTop := F.ram
  have hS : FB G.get.size fb 16 := ⟨F.ram, by have := F.sp_hi; have := F.sp_lo; omega, by have := F.sp_img; have := F.sp_lo; omega⟩
  have hf : FB G.get.size fp 40 := ⟨F.ram, F.f_mem, F.f_img⟩
  have hg : FB G.get.size gp 40 := ⟨F.ram, F.g_mem, F.g_img⟩
  have hfg := F.fg
  have hsf : fp.toNat + 40 ≤ fb.toNat ∨ fb.toNat + 16 ≤ fp.toNat := by have := F.f_stk; have := F.sp_lo; omega
  have hsg : gp.toNat + 40 ≤ fb.toNat ∨ fb.toNat + 16 ≤ gp.toNat := by have := F.g_stk; have := F.sp_lo; omega
  have hfs' : fb.toNat + 16 ≤ fp.toNat ∨ fp.toNat + 40 ≤ fb.toNat := by omega
  have hgs' : fb.toNat + 16 ≤ gp.toNat ∨ gp.toNat + 40 ≤ fb.toNat := by omega
  have hgf' : gp.toNat + 40 ≤ fp.toNat ∨ fp.toNat + 40 ≤ gp.toNat := by omega
  have l8 : rdRaw G.get (UInt32.add fb 8) 4 = ret := by rw [← hspfb]; exact hret0
  have l12 : rdRaw G.get (UInt32.add fb 12) 4 = b := by
    rw [show UInt32.add fb 12 = sp + 4 by rw [hspfb]; exact (uadd_assoc fb 8 4).symm]; exact hb0
  have Fs0 : Frame G fb 16 [(8, ret)] := (Frame.nil G fb 16).cons 8 ret rfl (by decide) l8
  have Ff0 := frame10 G fp fv hfv
  have Fg0 := frame10 G gp gv hgv
  have P0 : Pres G G (fun x => OutF fb 8 x ∧ (x < fp.toNat ∨ fp.toNat + 40 ≤ x) ∧
      (x < gp.toNat ∨ gp.toNat + 40 ≤ x)) := Pres.refl _ _
  have e0 : St.m ⟨G.get, a0, fp, gp, ebx0, sp, ebp0, esi0, edi0, 0x103b40, efl fl0, ic0⟩ =
      St.m ⟨G.get, a0, fp, gp, ebx0, UInt32.add fb 8, ebp0, esi0, edi0, 0x103b40, efl fl0, icAdd ic0 0⟩ := by
    rw [← hspfb]; rfl
  rw [e0]
  have R0 := cs_pro ic0 hic G fb hS a0 fp gp ebx0 ebp0 esi0 edi0 fl0 b l12
  have Fsa : Frame (stF G fb 16 4 edi0 hS (by decide)) fb 16 _ := Fs0.wrF 4 rfl rfl
  have Fs1 : Frame (stF0 (stF G fb 16 4 edi0 hS (by decide)) fb 16 esi0 stF_FB (by decide)) fb 16 _ := Fsa.wrF0
  have Ffa : Frame (stF G fb 16 4 edi0 hS (by decide)) fp 40 _ := Ff0.wrX hf hfs'
  have Ff1 : Frame (stF0 (stF G fb 16 4 edi0 hS (by decide)) fb 16 esi0 stF_FB (by decide)) fp 40 _ := Ffa.wrX0 (FB.size_eq stF_size hf) hfs'
  have Fga : Frame (stF G fb 16 4 edi0 hS (by decide)) gp 40 _ := Fg0.wrX hg hgs'
  have Fg1 : Frame (stF0 (stF G fb 16 4 edi0 hS (by decide)) fb 16 esi0 stF_FB (by decide)) gp 40 _ := Fga.wrX0 (FB.size_eq stF_size hg) hgs'
  have Pa : Pres G (stF G fb 16 4 edi0 hS (by decide)) _ := P0.wrS 4 rfl (fun x hx => by simp only [OutF] at hx; omega)
  have P1 : Pres G (stF0 (stF G fb 16 4 edi0 hS (by decide)) fb 16 esi0 stF_FB (by decide)) _ := Pa.wrS0 (fun x hx => by simp only [OutF] at hx; omega)
  clear Fsa Ffa Fga Pa
  generalize hN1 : stF0 (stF G fb 16 4 edi0 hS (by decide)) fb 16 esi0 stF_FB (by decide) = N1 at R0 Fs1 Ff1 Fg1 P1
  have sz1 : N1.get.size = G.get.size := by rw [← hN1]; simp only [stF_size, stF0_size]
  have hS1 := hS.size_eq sz1; have hf1 := hf.size_eq sz1; have hg1 := hg.size_eq sz1
  have R1 := cs_l0 ic0 hic N1 fb fp gp hS1 hf1 hg1 hfg (csM a0 b) ebx0 ebp0 (esi0) (edi0) (csMF a0 b) fv[0]! gv[0]!
      (Ff1.rd0 (rfl : List.lookup 0 _ = some fv[0]!)) (Fg1.rd0 (rfl : List.lookup 0 _ = some gv[0]!))
  have Ffa : Frame (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) fp 40 _ := Ff1.wrF0
  have Ff2 : Frame (stF0 (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) gp 40 (csG fv[0]! gv[0]! (csM a0 b)) (FB.size_eq stF0_size hg1) (by decide)) fp 40 _ := Ffa.wrX0 (FB.size_eq stF0_size hf1) hgf'
  have Fga : Frame (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) gp 40 _ := Fg1.wrX0 hg1 hfg
  have Fg2 : Frame (stF0 (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) gp 40 (csG fv[0]! gv[0]! (csM a0 b)) (FB.size_eq stF0_size hg1) (by decide)) gp 40 _ := Fga.wrF0
  have Fsa : Frame (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) fb 16 _ := Fs1.wrX0 hS1 hsf
  have Fs2 : Frame (stF0 (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) gp 40 (csG fv[0]! gv[0]! (csM a0 b)) (FB.size_eq stF0_size hg1) (by decide)) fb 16 _ := Fsa.wrX0 (FB.size_eq stF0_size hS1) hsg
  have Pa : Pres G (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) _ := P1.wrS0 (fun x hx => by simp only [OutF] at hx; omega)
  have P2 : Pres G (stF0 (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) gp 40 (csG fv[0]! gv[0]! (csM a0 b)) (FB.size_eq stF0_size hg1) (by decide)) _ := Pa.wrS0 (fun x hx => by simp only [OutF] at hx; omega)
  clear Ffa Fga Fsa Pa
  generalize hN2 : stF0 (stF0 N1 fp 40 (csF fv[0]! gv[0]! (csM a0 b)) hf1 (by decide)) gp 40 (csG fv[0]! gv[0]! (csM a0 b)) (FB.size_eq stF0_size hg1) (by decide) = N2 at R1 Ff2 Fg2 Fs2 P2
  have sz2 : N2.get.size = G.get.size := by rw [← hN2]; simp only [stF_size, stF0_size]; exact sz1
  have hS2 := hS.size_eq sz2; have hf2 := hf.size_eq sz2; have hg2 := hg.size_eq sz2
  have R2 := cs_l1 ic0 hic N2 fb fp gp hS2 hf2 hg2 hfg (csM a0 b) ebx0 ebp0 (csF fv[0]! gv[0]! (csM a0 b)) (csD fv[0]! gv[0]! (csM a0 b)) (csFl fv[0]! gv[0]! (csM a0 b)) fv[1]! gv[1]!
      (Ff2.rd (rfl : List.lookup 4 _ = some fv[1]!) 4 rfl) (Fg2.rd (rfl : List.lookup 4 _ = some gv[1]!) 4 rfl)
  have Ffa : Frame (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) fp 40 _ := Ff2.wrF 4 rfl rfl
  have Ff3 : Frame (stF (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) gp 40 4 (csG fv[1]! gv[1]! (csM a0 b)) (FB.size_eq stF_size hg2) (by decide)) fp 40 _ := Ffa.wrX (FB.size_eq stF_size hf2) hgf'
  have Fga : Frame (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) gp 40 _ := Fg2.wrX hg2 hfg
  have Fg3 : Frame (stF (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) gp 40 4 (csG fv[1]! gv[1]! (csM a0 b)) (FB.size_eq stF_size hg2) (by decide)) gp 40 _ := Fga.wrF 4 rfl rfl
  have Fsa : Frame (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) fb 16 _ := Fs2.wrX hS2 hsf
  have Fs3 : Frame (stF (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) gp 40 4 (csG fv[1]! gv[1]! (csM a0 b)) (FB.size_eq stF_size hg2) (by decide)) fb 16 _ := Fsa.wrX (FB.size_eq stF_size hS2) hsg
  have Pa : Pres G (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) _ := P2.wrS 4 rfl (fun x hx => by simp only [OutF] at hx; omega)
  have P3 : Pres G (stF (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) gp 40 4 (csG fv[1]! gv[1]! (csM a0 b)) (FB.size_eq stF_size hg2) (by decide)) _ := Pa.wrS 4 rfl (fun x hx => by simp only [OutF] at hx; omega)
  clear Ffa Fga Fsa Pa
  generalize hN3 : stF (stF N2 fp 40 4 (csF fv[1]! gv[1]! (csM a0 b)) hf2 (by decide)) gp 40 4 (csG fv[1]! gv[1]! (csM a0 b)) (FB.size_eq stF_size hg2) (by decide) = N3 at R2 Ff3 Fg3 Fs3 P3
  have sz3 : N3.get.size = G.get.size := by rw [← hN3]; simp only [stF_size, stF0_size]; exact sz2
  have hS3 := hS.size_eq sz3; have hf3 := hf.size_eq sz3; have hg3 := hg.size_eq sz3
  have R3 := cs_l2 ic0 hic N3 fb fp gp hS3 hf3 hg3 hfg (csM a0 b) ebx0 ebp0 (csF fv[1]! gv[1]! (csM a0 b)) (csD fv[1]! gv[1]! (csM a0 b)) (csFl fv[1]! gv[1]! (csM a0 b)) fv[2]! gv[2]!
      (Ff3.rd (rfl : List.lookup 8 _ = some fv[2]!) 8 rfl) (Fg3.rd (rfl : List.lookup 8 _ = some gv[2]!) 8 rfl)
  have Ffa : Frame (stF N3 fp 40 8 (csF fv[2]! gv[2]! (csM a0 b)) hf3 (by decide)) fp 40 _ := Ff3.wrF 8 rfl rfl
  have Ff4 : Frame (stF (stF N3 fp 40 8 (csF fv[2]! gv[2]! (csM a0 b)) hf3 (by decide)) gp 40 8 (csG fv[2]! gv[2]! (csM a0 b)) (FB.size_eq stF_size hg3) (by decide)) fp 40 _ := Ffa.wrX (FB.size_eq stF_size hf3) hgf'
  have Fga : Frame (stF N3 fp 40 8 (csF fv[2]! gv[2]! (csM a0 b)) hf3 (by decide)) gp 40 _ := Fg3.wrX hg3 hfg
  have Fg4 : Frame (stF (stF N3 fp 40 8 (csF fv[2]! gv[2]! (csM a0 b)) hf3 (by decide)) gp 40 8 (csG fv[2]! gv[2]! (csM a0 b)) (FB.size_eq stF_size hg3) (by decide)) gp 40 _ := Fga.wrF 8 rfl rfl
  have Fsa : Frame (stF N3 fp 40 8 (csF fv[2]! gv[2]! (csM a0 b)) hf3 (by decide)) fb 16 _ := Fs3.wrX hS3 hsf
  have Fs4 : Frame (stF (stF N3 fp 40 8 (csF fv[2]! gv[2]! (csM a0 b)) hf3 (by decide)) gp 40 8 (csG fv[2]! gv[2]! (csM a0 b)) (FB.size_eq stF_size hg3) (by decide)) fb 16 _ := Fsa.wrX (FB.size_eq stF_size hS3) hsg
  have Pa : Pres G (stF N3 fp 40 8 (csF fv[2]! gv[2]! (csM a0 b)) hf3 (by decide)) _ := P3.wrS 8 rfl (fun x hx => by simp only [OutF] at hx; omega)
