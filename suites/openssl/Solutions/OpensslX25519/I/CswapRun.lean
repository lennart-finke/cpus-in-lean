/-!
# The run of `fe_cswap`, in pieces

Generated by gen/gencswap.py. `fe_cswap(f, g, b)` (`f` in `ecx`, `g` in `edx`, `b` on the stack):
the prologue pushes `edi`, `esi` and computes the mask `0 - b`; limb `i` (seven instructions, two
stores) writes `f[i] ^ d` to `f` and `g[i] ^ d` to `g` with `d = (g[i] ^ f[i]) & mask`; the
epilogue pops and returns. The frame is the 16 bytes from `fb = sp - 8` (saved `esi`, `edi`, the
return address, `b`).
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519 Solutions.Exec.Mul Solutions.Exec.Fast

attribute [local cbv_opaque] Image.bytes
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option cbv.maxSteps 50000000

/-- The mask `0 - b` as the code computes it (`xorl %eax, %eax; subl 0xc(%esp), %eax`). -/
def csM (a b : UInt32) : UInt32 := (subF 4 (logicF 4 (a.xor a)).1 b 0).1
/-- The flags after the mask. -/
def csMF (a b : UInt32) : UInt32 := (subF 4 (logicF 4 (a.xor a)).1 b 0).2
/-- `(g ^ f) & mask`. -/
def csD (x y m : UInt32) : UInt32 := (logicF 4 ((logicF 4 (y.xor x)).1.land m)).1
/-- The new `f` limb. -/
def csF (x y m : UInt32) : UInt32 := (logicF 4 (x.xor (csD x y m))).1
/-- The new `g` limb. -/
def csG (x y m : UInt32) : UInt32 := (logicF 4 (y.xor (csD x y m))).1
/-- The flags after limb `i`. -/
def csFl (x y m : UInt32) : UInt32 := (logicF 4 (y.xor (csD x y m))).2

set_option exec.addrSub true in
/-- `pushl %edi ; pushl %esi ; xorl %eax, %eax ; subl 0xc(%esp), %eax` -/
theorem cs_pro (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) (N : XMem) (fb : UInt32) (hS : FB N.get.size fb 16)
    (a0 fp gp ebx ebp esi edi fl b : UInt32) (lb : rdRaw N.get (UInt32.add fb 12) 4 = b) :
    Run img (St.m ⟨N.get, a0, fp, gp, ebx, UInt32.add fb 8, ebp, esi, edi, 0x103b40, efl fl, icAdd ic0 0⟩)
      (St.m ⟨(stF0 (stF N fb 16 4 edi hS (by decide)) fb 16 esi stF_FB (by decide)).get, csM a0 b, fp, gp, ebx,
        fb, ebp, esi, edi, 0x103b48, efl (csMF a0 b), icAdd ic0 4⟩) := by
  refine run_of_runI (k := 4) ?_ (icB hic (by decide))
  subst lb
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  cbv

