theorem FieldFactsW.size_eq {s s' sp h f g : Nat} (e : s' = s) (F : FieldFactsW 4 s sp h f g) :
    FieldFactsW 4 s' sp h f g := e ▸ F

theorem at_sW {sp : UInt32} (hsp : 4 ≤ sp.toNat) : (UInt32.sub sp 4).toNat = sp.toNat - 4 := by
  show (sp - 4).toNat = _
  rw [UInt32.toNat_sub_of_le _ _ (by rw [UInt32.le_iff_toNat_le]; simp; omega)]
  simp

theorem at_s4W {sp : UInt32} (hsp : 4 ≤ sp.toNat) :
    (UInt32.add (UInt32.sub sp 4) 4).toNat = sp.toNat - 4 + 4 := by
  have := sp.toNat_lt
  show (sp - 4 + 4).toNat = _
  rw [UInt32.toNat_add, show (sp - 4).toNat = sp.toNat - 4 from at_sW hsp]
  simp
  omega

