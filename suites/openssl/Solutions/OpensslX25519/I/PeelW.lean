  have h4 := F.sp_hi
  have h5 := F.sp_img
  have hl : (UInt32.sub sp 4).toNat = sp.toNat - 4 := by
    show (sp - 4).toNat = _
    rw [UInt32.toNat_sub_of_le _ _ (by rw [UInt32.le_iff_toNat_le]; simp; omega)]
    simp
  refine ⟨?_, ?_⟩
  · show (UInt32.sub sp 4).toNat + 4 ≤ N.get.size
    omega
  · show _ ∨ _
