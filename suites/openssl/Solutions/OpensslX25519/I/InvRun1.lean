theorem inv_c0a (ic : UInt64) (hic : ic.toNat < 2 ^ 63) (N : XMem) (L : UInt32) (hS : FB N.get.size L 192)
    (eax ecx edx ebx ebp esi edi fl : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add L 8, ebp, esi, edi, 0x1005da, efl fl, icAdd ic 0⟩)
      (St.m ⟨(stF N L 192 8 ecx hS (by decide)).get, eax, UInt32.add L 52, edx, ebx, UInt32.add L 8, ebp, edx, UInt32.add L 52, 0x1005e5, efl fl, icAdd ic 4⟩) := by
  refine run_of_runI (k := 4) ?_ (icB hic (by decide))
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  cbv

