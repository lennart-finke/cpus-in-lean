theorem inv_p110 (ic : UInt64) (hic : ic.toNat < 2 ^ 63) (N : XMem) (L : UInt32) (hS : FB N.get.size L 192)
    (eax ecx edx ebx ebp esi edi fl : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add L 8, ebp, esi, edi, 0x1009fb, efl fl, icAdd ic 0⟩)
      (St.m ⟨(stF N L 192 4 0x100a04 hS (by decide)).get, eax, ebp, ebp, ebx, UInt32.add L 4, ebp, esi, edi, 0x102360, efl fl, icAdd ic 3⟩) := by
  refine run_of_runI (k := 3) ?_ (icB hic (by decide))
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  cbv

