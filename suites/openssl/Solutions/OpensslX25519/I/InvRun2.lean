    (eax ecx edx ebx ebp esi edi fl : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add L 8, ebp, esi, edi, 0x1006d5, efl fl, icAdd ic 0⟩)
      (St.m ⟨(stF N L 192 4 0x1006e2 hS (by decide)).get, eax, UInt32.add L 12, ebp, ebx, UInt32.add L 4, ebp, UInt32.add L 12, edi, 0x102360, efl fl, icAdd ic 4⟩) := by
  refine run_of_runI (k := 4) ?_ (icB hic (by decide))
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  cbv

