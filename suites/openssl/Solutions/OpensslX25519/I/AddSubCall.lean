theorem fe_add_call (G : XMem) (sp h f g ret : UInt32) (fv gv : Array UInt32)
    (F0 : FieldFactsW 4 G.get.size sp.toNat h.toNat f.toNat g.toNat) (hret0 : rdRaw G.get sp 4 = ret)
    (hg0 : rdRaw G.get (sp + 4) 4 = g) (hfm : memWords G.get f 10 = fv) (hgm : memWords G.get g 10 = gv)
    (hfin : AddIn fv) (hgin : AddIn gv) (a0 ebx0 ebp0 esi0 edi0 fl0 : UInt32)
    (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) :
    ∃ (N : XMem) (eax ecx edx fl : UInt32),
      Run img (St.m ⟨G.get, a0, h, f, ebx0, sp, ebp0, esi0, edi0, Image.sym_fe_add, efl fl0, ic0⟩)
        (St.m ⟨N.get, eax, ecx, edx, ebx0, sp + 4, ebp0, esi0, edi0, ret, efl fl, icAdd ic0 34⟩) ∧
      Pres G N (OutH (sp - 4) 4 h) ∧
      AddOut (memWords N.get h 10) ∧ feValI (memWords N.get h 10) % pI = (feValI fv + feValI gv) % pI := by
  obtain ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩ := id F0
  have hargE : rdRaw G.get (UInt32.add (UInt32.sub sp 4) 8) 4 = g := by
    have := hg0
    rw [show UInt32.add (UInt32.sub sp 4) 8 = sp + 4 by
      apply UInt32.toNat_inj.1
      have := sp.toNat_lt
      simp only [toNat_uadd, toNat_usub, UInt32.toNat_add, UInt32.toNat_mul]; simp; omega]
    exact this
  have hret : rdRaw G.get (UInt32.add (UInt32.sub sp 4) 4) 4 = ret := by
    rw [show UInt32.add (UInt32.sub sp 4) 4 = sp by
      apply UInt32.toNat_inj.1
      have := sp.toNat_lt
      simp only [toNat_uadd, toNat_usub]; simp; omega]
    exact hret0
  have e0 : St.m ⟨G.get, a0, h, f, ebx0, sp, ebp0, esi0, edi0, Image.sym_fe_add, efl fl0, ic0⟩ =
      St.m ⟨G.get, a0, h, f, ebx0, sp, ebp0, esi0, edi0, Image.sym_fe_add, efl fl0, icAdd ic0 0⟩ := rfl
  rw [e0]
  have ok0 := storeOk_spW G F0
  let N1 := CodeMem.wr4 G (UInt32.sub sp 4) esi0 ok0
  have s1 : N1.get.size = G.get.size := wr4_size _ _ _ _
  have p := add_pro ic0 G a0 ebx0 sp ebp0 esi0 edi0 fl0 h f g
    (⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok0
  rw [hargE] at p
  have ok1 := storeOk_h0W N1 rfl (FieldFactsW.size_eq s1 F0)
  let r0 := addF 4 (rdRaw N1.get g 4) (rdRaw N1.get f 4) 0
  let N2 := CodeMem.wr4 N1 h r0.1 ok1
  have s2 : N2.get.size = G.get.size := (wr4_size _ _ _ _).trans s1

  have ok2 := storeOk_hW N2 rfl (FieldFactsW.size_eq s2 F0) 4 (by decide)
  let r1 := addF 4 (rdRaw N2.get (UInt32.add g 4) 4) (rdRaw N2.get (UInt32.add f 4) 4) 0
  let N3 := CodeMem.wr4 N2 (UInt32.add h 4) r1.1 ok2
  have s3 : N3.get.size = G.get.size := (wr4_size _ _ _ _).trans s2

  have ok3 := storeOk_hW N3 rfl (FieldFactsW.size_eq s3 F0) 8 (by decide)
  let r2 := addF 4 (rdRaw N3.get (UInt32.add g 8) 4) (rdRaw N3.get (UInt32.add f 8) 4) 0
  let N4 := CodeMem.wr4 N3 (UInt32.add h 8) r2.1 ok3
  have s4 : N4.get.size = G.get.size := (wr4_size _ _ _ _).trans s3

  have ok4 := storeOk_hW N4 rfl (FieldFactsW.size_eq s4 F0) 12 (by decide)
  let r3 := addF 4 (rdRaw N4.get (UInt32.add g 12) 4) (rdRaw N4.get (UInt32.add f 12) 4) 0
  let N5 := CodeMem.wr4 N4 (UInt32.add h 12) r3.1 ok4
