  have ok10 := storeOk_hW N10 rfl (FieldFactsW.size_eq s10 F0) 36 (by decide)
  let r9 := addF 4 (rdRaw N10.get (UInt32.add g 36) 4) (rdRaw N10.get (UInt32.add f 36) 4) 0
  let N11 := CodeMem.wr4 N10 (UInt32.add h 36) r9.1 ok10
  have s11 : N11.get.size = G.get.size := (wr4_size _ _ _ _).trans s10

  have RR := (Run.trans (runIc hic p) (Run.trans (runIc hic (add_limb0 ic0 N1 ebx0 sp ebp0 esi0 edi0 fl0 h f g
    (FieldFactsW.size_eq s1 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok1))
    (Run.trans (runIc hic (add_limb1 ic0 N2 ebx0 sp ebp0 r0.1 edi0 r0.2 h f g
    (FieldFactsW.size_eq s2 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok2))
    (Run.trans (runIc hic (add_limb2 ic0 N3 ebx0 sp ebp0 r1.1 edi0 r1.2 h f g
    (FieldFactsW.size_eq s3 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok3))
    (Run.trans (runIc hic (add_limb3 ic0 N4 ebx0 sp ebp0 r2.1 edi0 r2.2 h f g
    (FieldFactsW.size_eq s4 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok4))
    (Run.trans (runIc hic (add_limb4 ic0 N5 ebx0 sp ebp0 r3.1 edi0 r3.2 h f g
    (FieldFactsW.size_eq s5 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok5))
    (Run.trans (runIc hic (add_limb5 ic0 N6 ebx0 sp ebp0 r4.1 edi0 r4.2 h f g
    (FieldFactsW.size_eq s6 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok6))
    (Run.trans (runIc hic (add_limb6 ic0 N7 ebx0 sp ebp0 r5.1 edi0 r5.2 h f g
    (FieldFactsW.size_eq s7 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok7))
    (Run.trans (runIc hic (add_limb7 ic0 N8 ebx0 sp ebp0 r6.1 edi0 r6.2 h f g
    (FieldFactsW.size_eq s8 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok8))
    (Run.trans (runIc hic (add_limb8 ic0 N9 ebx0 sp ebp0 r7.1 edi0 r7.2 h f g
    (FieldFactsW.size_eq s9 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok9))
    (Run.trans (runIc hic (add_limb9 ic0 N10 ebx0 sp ebp0 r8.1 edi0 r8.2 h f g
    (FieldFactsW.size_eq s10 ⟨f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16⟩) ok10))
