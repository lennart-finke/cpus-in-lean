  have e2 : rdRaw N11.get (UInt32.sub sp 4) 4 = esi0 := by
    rw [rd_sbW N10 s10 (sp := sp.toNat) (t := 0) (at_b rfl F0.h_mem F0.ram 36 (by decide)) (at_sW f3) (by decide) (by decide) F0.h_stk f3 f4,
