  have e1 : rdRaw N11.get (UInt32.add (UInt32.sub sp 4) 4) 4 = ret := by
    rw [rd_sbW N10 s10 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 36 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N9 s9 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 32 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N8 s8 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 28 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N7 s7 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 24 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N6 s6 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 20 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N5 s5 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 16 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N4 s4 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 12 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N3 s3 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 8 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N2 s2 (sp := sp.toNat) (t := 4) (at_b rfl F0.h_mem F0.ram 4 (by decide)) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_sbW N1 s1 (sp := sp.toNat) (t := 4) (at0 h) (at_s4W f3) (by decide) (by decide) F0.h_stk f3 f4,
      rd_ssW G rfl (at_sW f3) (at_s4W f3) f3 f4]
