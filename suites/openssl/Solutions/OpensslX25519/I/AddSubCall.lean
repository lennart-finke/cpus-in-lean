  have ok5 := storeOk_hW N5 rfl (FieldFactsW.size_eq s5 F0) 16 (by decide)
  let r4 := addF 4 (rdRaw N5.get (UInt32.add g 16) 4) (rdRaw N5.get (UInt32.add f 16) 4) 0
  let N6 := CodeMem.wr4 N5 (UInt32.add h 16) r4.1 ok5
