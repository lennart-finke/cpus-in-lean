set_option exec.addrSub true in
/-- addl -/
theorem fb_p42 (ic : UInt64) (hic : ic.toNat < 2 ^ 63) (G N : XMem) (L s : UInt32) (hS : FB N.get.size L 72)
    (l : List (Nat × UInt32)) (hF : Frame N L 72 l) (hP : Pres G N (OutF L 68)) (v84 v85 v80 v82 v56 v83 v74 g75 v40 v86 g76 : UInt32)
    (l_v40 : l.lookup 24 = some v40)
    (e_v86 : v86 = UInt32.add v85 v40)
    (e_g76 : g76 = (addF 4 v85 v40 0).2) :
    ∃ N' : XMem, Run img (St.m ⟨N.get, v84, v85, v80, v82, UInt32.add L 4, v56, v83, v74, 0x1038c4, efl g75, icAdd ic 0⟩)
      (St.m ⟨N'.get, v84, v86, v80, v82, UInt32.add L 4, v56, v83, v74, 0x1038c8, efl g76, icAdd ic 1⟩) ∧
      Frame N' L 72 (l) ∧ Pres G N' (OutF L 68) := by
  refine ⟨N, run_of_runI (k := 1) ?_ (icB hic (by decide)), hF, hP⟩
  subst e_g76
  subst e_v86
  have r_v40 := hF.rd l_v40 24 rfl; subst r_v40
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  clear hF hP
  cbv

