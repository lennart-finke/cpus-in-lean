/-!
# `fe_frombytes` as a callee

Generated by `gen/gentfbmain.py` (prover Q). The run of `fe_frombytes(h, s)` (`h` in `ecx`, `s` in `edx`) from its
pieces (`I/FbEnds`, `I/FbRun*`) at any instruction count, with the frame `[L, L + 72)` (the return address at
`L + 68`): it writes only its frame below `L + 68` and the 40 bytes at `h`, whose limbs are within the `fe_mul`
output bounds (`fbl<i>`) and represent `decodeU` of the 32 bytes at `s` modulo `p` (`fb_value`).
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519 Solutions.Exec.Mul Solutions.OpensslX25519
  Solutions.Exec.Shift Solutions.Exec.Bit

attribute [local irreducible] rdRaw

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem fe_frombytes_call (G : XMem) (L hp s ret : UInt32) (u : List UInt8)
    (hS : FB G.get.size L 72) (hret : rdRaw G.get (UInt32.add L 68) 4 = ret)
    (hpm : hp.toNat + 40 ≤ G.get.size) (hpi : hp.toNat + 40 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ hp.toNat)
    (hpL : hp.toNat + 40 ≤ L.toNat ∨ L.toNat + 72 ≤ hp.toNat)
    (hsm : s.toNat + 32 ≤ G.get.size) (hsi : s.toNat + 32 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ s.toNat)
    (hsL : s.toNat + 32 ≤ L.toNat ∨ L.toNat + 72 ≤ s.toNat)
    (hu : memBytes G.get s 32 = u) (a0 ebx0 ebp0 esi0 edi0 fl0 : UInt32) (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 62) :
    ∃ (N : XMem) (eax ecx edx fl : UInt32),
      Run img (St.m ⟨G.get, a0, hp, s, ebx0, UInt32.add L 68, ebp0, esi0, edi0, 0x1036f0, efl fl0, icAdd ic0 0⟩)
        (St.m ⟨N.get, eax, ecx, edx, ebx0, UInt32.add L 72, ebp0, esi0, edi0, ret, efl fl, icAdd ic0 210⟩) ∧
      Pres G N (OutH L 68 hp) ∧ MulOut (memWords N.get hp 10) ∧
      feValI (memWords N.get hp 10) % pI = (Ssl.Spec.X25519.decodeU u : Int) % pI := by
  have htop : G.get.size ≤ ramTop := hS.top
  have hT : G.get.size < 2 ^ 32 := by unfold ramTop at htop; omega
  have hic63 : ic0.toNat < 2 ^ 63 := by clear hsi hsL hpi hpL hu; omega
  have hicB : ∀ m : Nat, m ≤ 210 → (icAdd ic0 m).toNat < 2 ^ 63 := fun m hm =>
    icB' (k := 0) (by clear hsi hsL hpi hpL hu; omega)
  have hRd : ∀ k n : Nat, k + n ≤ 32 → s.toNat + k + n ≤ G.get.size := by
    intro k n h; clear hsi hsL hpi hpL hu; omega
  have hOk1 : ∀ k : Nat, k < 32 → OutF L 68 (s.toNat + k) := by
    intro k hk; unfold OutF; clear hsi hpi hpL hu hsm; omega
  have hOkJ : ∀ k j : Nat, k + j < 32 → OutF L 68 (s.toNat + k + j) := by
    intro k j hk; unfold OutF; clear hsi hpi hpL hu hsm; omega
  have hAs : ∀ k : UInt32, k.toNat < 32 → (UInt32.add s k).toNat = s.toNat + k.toNat := fun k hk => by
    rw [toNat_uadd]; clear hsi hsL hpi hpL hu hRd hOk1 hOkJ hicB; omega
  have mbAs : ∀ i : Nat, i < 32 → (memByte G.get (s + i.toUInt32)).toNat = (G.get.get! (s.toNat + i)).toNat :=
    fun i hi => by
      have e : (s + i.toUInt32).toNat = s.toNat + i := by
        rw [UInt32.toNat_add, Nat.toUInt32, UInt32.toNat_ofNat']; clear hsi hsL hpi hpL hu hRd hOk1 hOkJ hicB hAs; omega
      rw [memByte_def (by rw [e]; exact hRd i 1 hi), e]
@HS
@MB
-- @@READS
  have hD : Ssl.Spec.X25519.decodeU u = @HORNER := by
    rw [← hu]
    show Ssl.Spec.X25519.decodeU ((List.range 32).map fun i => memByte G.get (s + i.toUInt32)) = _
    rw [decodeU_horner, u8_and127, @MBS]
  obtain ⟨g0, eg0⟩ : ∃ y : UInt32, y = (subF 4 (UInt32.add L 52) 48 0).2 := ⟨_, rfl⟩
-- @@DEFS
-- @@FACTS
-- @@CALLS
  have sv0 := sv_of_nat m0 ⟨Int.le_trans (by decide) b0, Int.lt_of_le_of_lt b0' (by decide)⟩
  have sv1 := sv_of_nat m1 ⟨Int.le_trans (by decide) b1, Int.lt_of_le_of_lt b1' (by decide)⟩
  have sv2 := sv_of_nat m2 ⟨Int.le_trans (by decide) b2, Int.lt_of_le_of_lt b2' (by decide)⟩
  have sv3 := sv_of_nat m3 ⟨Int.le_trans (by decide) b3, Int.lt_of_le_of_lt b3' (by decide)⟩
  have sv4 := sv_of_nat m4 ⟨Int.le_trans (by decide) b4, Int.lt_of_le_of_lt b4' (by decide)⟩
  have sv5 := sv_of_nat m5 ⟨Int.le_trans (by decide) b5, Int.lt_of_le_of_lt b5' (by decide)⟩
  have sv6 := sv_of_nat m6 ⟨Int.le_trans (by decide) b6, Int.lt_of_le_of_lt b6' (by decide)⟩
  have sv7 := sv_of_nat m7 ⟨Int.le_trans (by decide) b7, Int.lt_of_le_of_lt b7' (by decide)⟩
  have sv8 := sv_of_nat m8 ⟨Int.le_trans (by decide) b8, Int.lt_of_le_of_lt b8' (by decide)⟩
  have sv9 := sv_of_nat m9 ⟨Int.le_trans (by decide) b9, Int.lt_of_le_of_lt b9' (by decide)⟩
  have hval := fb_value @BARGS (sv v63) (sv v61) (sv v70) (sv v68) (sv v76) (sv v74) (sv v82) (sv v80) (sv v88)
    (sv v86) @BBNDS @HVS rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl
    sv0 sv1 sv2 sv3 sv4 sv5 sv6 sv7 sv8 sv9 hD
  -- the run
  have F0 : Frame G L 72 [(68, ret)] := by
    intro k v hl
    rw [lookup_cons] at hl
    split at hl
    · rename_i hk; subst hk; simp only [Option.some.injEq] at hl; subst hl; exact ⟨rfl, by decide, hret⟩
    · simp at hl
  obtain ⟨N1, R1, F1, P1⟩ := fb_pro ic0 hic63 G L hS _ F0 a0 hp s ebx0 ebp0 esi0 edi0 fl0
  have hS1 : FB N1.get.size L 72 := hS.size_eq P1.1
  have R2 := fb_sub (icAdd ic0 4) (hicB 4 (by decide)) N1 L hS1 a0 hp s ebx0 ebp0 esi0 edi0 fl0
  rw [icAdd_add, icAdd_add, ← eg0] at R2
  have Rn := R1.trans R2
  clear R1 R2
-- @@PIECES
  have hH : FB N@K.get.size hp 40 := ⟨by rw [P@K.1]; exact htop, by rw [P@K.1]; exact hpm, hpi⟩
  obtain ⟨M1, o1, Fa, Fh1, Q1⟩ := fb_o1 (icAdd ic0 188) (hicB 188 (by decide)) G N@K L hp hS@K hH hpL _ _ F@K
    (Frame.nil _ _ _) (P@K.toH hp) @OREGS @FL v63 v61 v70 v68 rfl rfl rfl rfl rfl
  rw [icAdd_add, icAdd_add] at o1
  have hSa : FB M1.get.size L 72 := hS.size_eq Q1.1
  have hHa : FB M1.get.size hp 40 := hH.size_eq (Q1.1.trans P@K.1.symm)
  obtain ⟨M2, o2, Fb, Fh2, Q2⟩ := fb_o2 (icAdd ic0 197) (hicB 197 (by decide)) G M1 L hp hSa hHa hpL _ _ Fa
    Fh1 Q1 @O2REGS v76 rfl
  rw [icAdd_add, icAdd_add] at o2
  have hSb : FB M2.get.size L 72 := hS.size_eq Q2.1
  have hHb : FB M2.get.size hp 40 := hH.size_eq (Q2.1.trans P@K.1.symm)
  obtain ⟨M3, o3, Fc, Fh3, Q3⟩ := fb_o3 (icAdd ic0 202) (hicB 202 (by decide)) G M2 L hp hSb hHb hpL _ _ Fb
    Fh2 Q2 @O3REGS
  rw [icAdd_add, icAdd_add] at o3
  have hSc : FB M3.get.size L 72 := hS.size_eq Q3.1
  have ra := fb_add (icAdd ic0 204) (hicB 204 (by decide)) M3 L hSc @O4REGS
  rw [icAdd_add, icAdd_add] at ra
  have re := fb_epi (icAdd ic0 205) (hicB 205 (by decide)) M3 L hSc @O4REGS0 (addF 4 (UInt32.add L 4) 48 0).2
    esi0 edi0 ebx0 ebp0 ret
    (Fc.rd (rfl : List.lookup 52 _ = some esi0) 52 rfl) (Fc.rd (rfl : List.lookup 56 _ = some edi0) 56 rfl)
    (Fc.rd (rfl : List.lookup 60 _ = some ebx0) 60 rfl) (Fc.rd (rfl : List.lookup 64 _ = some ebp0) 64 rfl)
    (Fc.rd (rfl : List.lookup 68 _ = some ret) 68 rfl)
  rw [icAdd_add, icAdd_add] at re
  have hmw : memWords M3.get hp 10 = Array.ofFn (n := 10) fun i =>
      ([v63, v61, v70, v68, v76, v74, v82, v80, v88, v86].getD i.val 0) :=
    memWords_frame Fh3 (fun i => [v63, v61, v70, v68, v76, v74, v82, v80, v88, v86].getD i 0) (fun i hi => by
      have := fz_lt10 i hi
      rcases this with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl)
  refine ⟨M3, _, _, _, _, Rn.trans (o1.trans (o2.trans (o3.trans (ra.trans re)))), ?_, ?_, ?_⟩
  · exact Q3
  · rw [hmw]
    refine mulOut_fn (fun i => [v63, v61, v70, v68, v76, v74, v82, v80, v88, v86].getD i 0) (fun i hi => ?_)
    have := fz_lt10 i hi
    rcases this with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact fb_bnd_even sv0 b0 b0'
    · exact fb_bnd_odd sv1 b1 b1'
    · exact fb_bnd_even sv2 b2 b2'
    · exact fb_bnd_odd sv3 b3 b3'
    · exact fb_bnd_even sv4 b4 b4'
    · exact fb_bnd_odd sv5 b5 b5'
    · exact fb_bnd_even sv6 b6 b6'
    · exact fb_bnd_odd sv7 b7 b7'
    · exact fb_bnd_even sv8 b8 b8'
    · exact fb_bnd_odd sv9 b9 b9'
  · rw [hmw, feValI_fn (fun i => [v63, v61, v70, v68, v76, v74, v82, v80, v88, v86].getD i 0)]
    exact hval

end Solutions.OpensslX25519.I
