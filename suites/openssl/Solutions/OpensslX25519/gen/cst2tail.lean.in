
/-- Two buffers updated (`fe_cswap`). -/
theorem CSt.next2 {G N N' : XMem} {L : UInt32} {n W : Nat} {sl : List (Nat × UInt32)} {bf : List (Nat × Array UInt32)}
    (C : CSt G N L n W sl bf) (k1 k2 : Nat) (h1 : k1 ∈ bf.map Prod.fst) (h2 : k2 ∈ bf.map Prod.fst)
    (hP : Pres N N' (fun x => (x < L.toNat - W ∨ L.toNat + 8 ≤ x) ∧ (x < L.toNat + k1 ∨ L.toNat + k1 + 40 ≤ x) ∧
      (x < L.toNat + k2 ∨ L.toNat + k2 + 40 ≤ x))) :
    CSt G N' L n W sl (upd (upd bf k1 (memWords N'.get (UInt32.add L k1.toUInt32) 10)) k2
      (memWords N'.get (UInt32.add L k2.toUInt32) 10)) := by
  have hsz : N'.get.size = N.get.size := hP.1
  have hb1 := lay_buf C.lay h1
  have hb2 := lay_buf C.lay h2
  refine ⟨by rw [hsz]; exact C.top, by rw [hsz]; exact C.fit, C.w_lo, by rw [hsz]; exact C.hi, C.imgok,
    (C.pres.trans hP).mono fun x hx => ⟨hx, ?_, ?_, ?_⟩, fun k v hl => ?_, fun k v hl => ?_, ?_⟩
  · omega
  · omega
  · omega
  · have hk := lay_slot C.lay (mem_of_lookup hl)
    have e := C.addr (k := k) (by omega)
    rw [← C.slot k v hl]
    exact hP.rd C.top (by rw [e]; have := C.hi; omega) (fun j hj => by
      rw [e]; have := hk.2.2 k1 h1; have := hk.2.2 k2 h2; omega)
  · by_cases hk2 : k = k2
    · subst hk2
      rw [lookup_upd_self _ _ _ (by rw [keys_upd]; exact h2)] at hl
      cases hl; rfl
    · rw [lookup_upd_ne _ _ _ _ hk2] at hl
      by_cases hk1 : k = k1
      · subst hk1
        rw [lookup_upd_self _ _ _ h1] at hl
        cases hl; rfl
      · rw [lookup_upd_ne _ _ _ _ hk1] at hl
        have hkm := mem_of_lookup hl
        have hb := lay_buf C.lay hkm
        have hbb1 := lay_bb C.lay hkm h1
        have hbb2 := lay_bb C.lay hkm h2
        have e := C.addr (k := k) (by omega)
        rw [← C.buf k v hl]
        exact memWords_pres hP C.top (by rw [e]; have := C.hi; omega) (fun j hj => by rw [e]; omega)
  · rw [keys_upd, keys_upd]; exact C.lay

/-- A call of `fe_cswap(L + kf, L + kg, b)` from the frame (`b` pushed). -/
theorem CSt.cswap {G N : XMem} {L : UInt32} {n W : Nat} {sl : List (Nat × UInt32)} {bf : List (Nat × Array UInt32)}
    (C : CSt G N L n W sl bf) (hW : 8 ≤ W) (hn : 8 ≤ n) (kf kg : Nat) (hne : kf ≠ kg)
    {vf vg : Array UInt32} (hkf : bf.lookup kf = some vf) (hkg : bf.lookup kg = some vg)
    (b : UInt32) (hb : b = 0 ∨ b = 1) (r a ebx ebp esi edi f : UInt32) (ic0 : UInt64) (c : Nat)
    (hic : ic0.toNat + c + 77 < 2 ^ 63) (s0 : Machine) (h4 : (4 : UInt32).toNat + 4 ≤ n) (h0 : 4 ≤ n)
    (R : Run img s0 (St.m ⟨(stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0).get, a,
      UInt32.add L kf.toUInt32, UInt32.add L kg.toUInt32, ebx, L, ebp, esi, edi, 0x103b40, efl f, icAdd ic0 c⟩)) :
    ∃ (N' : XMem) (eax ecx edx fl : UInt32),
      Run img s0 (St.m ⟨N'.get, eax, ecx, edx, ebx, UInt32.add L 4, ebp, esi, edi, r, efl fl, icAdd ic0 (c + 77)⟩) ∧
      CSt G N' L n W sl (upd (upd bf kf (memWords N'.get (UInt32.add L kf.toUInt32) 10)) kg
        (memWords N'.get (UInt32.add L kg.toUInt32) 10)) ∧
      memWords N'.get (UInt32.add L kf.toUInt32) 10 = (if b = 1 then vg else vf) ∧
      memWords N'.get (UInt32.add L kg.toUInt32) 10 = (if b = 1 then vf else vg) := by
  have hkf' := mem_of_lookup hkf
  have hkg' := mem_of_lookup hkg
  have bf' := lay_buf C.lay hkf'
  have bg := lay_buf C.lay hkg'
  have bfg := lay_bb C.lay hkf' hkg'
  have ef := C.addr (k := kf) (by omega)
  have eg := C.addr (k := kg) (by omega)
  have hsz : (stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0).get.size = N.get.size := by
    rw [stF0_size, stF_size]
  have P1 : Pres N (stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0) (OutF L 8) :=
    ((Pres.refl N _).wrF (by decide)).wrF0 (by decide)
  have hi := C.hi; have hw := C.w_lo; have himg := C.imgok; have htop := C.top
  have F1 : CswapFacts (stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0).get.size L.toNat
      (UInt32.add L kf.toUInt32).toNat (UInt32.add L kg.toUInt32).toNat := by
    rw [hsz, ef, eg]
    exact ⟨htop, by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega⟩
  have FF := ((Frame.nil N L n).wrF 4 (j := 4) (v := b) (h := C.fb) (hj := h4) rfl rfl).wrF0
    (v := r) (h := stF_FB) (hn := h0)
  have hret : rdRaw (stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0).get L 4 = r :=
    FF.rd0 (rfl : List.lookup 0 _ = some r)
  have hb0 : rdRaw (stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0).get (L + 4) 4 = b :=
    FF.rd (rfl : List.lookup 4 _ = some _) 4 rfl
  have hfv : memWords (stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0).get (UInt32.add L kf.toUInt32) 10 = vf := by
    rw [memWords_pres P1 htop (by rw [ef]; omega) (fun j hj => by rw [ef]; unfold OutF; omega)]
    exact C.buf kf vf hkf
  have hgv : memWords (stF0 (stF N L n 4 b C.fb h4) L n r stF_FB h0).get (UInt32.add L kg.toUInt32) 10 = vg := by
    rw [memWords_pres P1 htop (by rw [eg]; omega) (fun j hj => by rw [eg]; unfold OutF; omega)]
    exact C.buf kg vg hkg
  obtain ⟨N', eax, ecx, edx, fl, Rc, Pc, Mf, Mg⟩ := fe_cswap_call _ L (UInt32.add L kf.toUInt32)
    (UInt32.add L kg.toUInt32) r b vf vg F1 hret hb0 hb hfv hgv a ebx ebp esi edi f
    (icAdd ic0 c) (by rw [icAdd_toNat _ _ (by omega)]; omega)
  rw [icAdd_add] at Rc
  refine ⟨N', eax, ecx, edx, fl, R.trans Rc, C.next2 kf kg hkf' hkg' ((P1.trans Pc).mono fun x hx => ⟨?_, ?_⟩),
    Mf, Mg⟩
  · unfold OutF; have := hx.1; omega
  · have e8 : (L - 8).toNat = L.toNat - 8 := by
      rw [UInt32.toNat_sub]; unfold ramTop at htop; simp only [UInt32.reduceToNat]; omega
    unfold OutF; rw [e8, ef, eg]; omega

/-- A word store into a slot of the frame. -/
theorem CSt.wr_slot {G N : XMem} {L : UInt32} {n W : Nat} {sl : List (Nat × UInt32)} {bf : List (Nat × Array UInt32)}
    (C : CSt G N L n W sl bf) (k : Nat) (hk : k ∈ sl.map Prod.fst) (hk4 : k % 4 = 0) (v : UInt32)
    (hal : ∀ k', k' ∈ sl.map Prod.fst → k' % 4 = 0)
    (hj : (k.toUInt32).toNat + 4 ≤ n) :
    CSt G (stF N L n k.toUInt32 v C.fb hj) L n W (upd sl k v) bf := by
  have hs := lay_slot C.lay hk
  have hsz : (stF N L n k.toUInt32 v C.fb hj).get.size = N.get.size := stF_size
  have ek : (k.toUInt32).toNat = k := by
    have := C.hi; have := C.top; unfold ramTop at *
    rw [Nat.toUInt32, UInt32.toNat_ofNat']; omega
  have P1 : Pres N (stF N L n k.toUInt32 v C.fb hj) (fun x => x < L.toNat + k ∨ L.toNat + k + 4 ≤ x) :=
    (Pres.refl N _).wr _ (fun x hx => by rw [C.fb.add_toNat (by omega), ek]; omega)
  refine ⟨by rw [hsz]; exact C.top, by rw [hsz]; exact C.fit, C.w_lo, by rw [hsz]; exact C.hi, C.imgok,
    (C.pres.trans P1).mono fun x hx => ⟨hx, by omega⟩, fun k' v' hl => ?_, fun k' v' hl => ?_, ?_⟩
  · by_cases hkk : k' = k
    · subst hkk
      rw [lookup_upd_self _ _ _ hk] at hl
      cases hl
      have := rd_wr4_frame N C.fb (v := v) (ok := storeOk_fb N C.fb hj) (j := k') (k := k')
        (by rw [C.fb.add_toNat (by omega), ek]) hk4 hk4 (by omega)
      rw [if_pos rfl] at this; exact this
    · rw [lookup_upd_ne _ _ _ _ hkk] at hl
      have hk' := lay_slot C.lay (mem_of_lookup hl)
      have h4' := hal k' (mem_of_lookup hl)
      have e := C.addr (k := k') (by omega)
      rw [← C.slot k' v' hl]
      exact P1.rd C.top (by rw [e]; have := C.hi; omega) (fun j hj => by rw [e]; omega)
  · have hkm := mem_of_lookup hl
    have hb := lay_buf C.lay hkm
    have := hs.2.2 k' hkm
    have e := C.addr (k := k') (by omega)
    rw [← C.buf k' v' hl]
    exact memWords_pres P1 C.top (by rw [e]; have := C.hi; omega) (fun j hj => by rw [e]; omega)
  · rw [keys_upd]; exact C.lay
