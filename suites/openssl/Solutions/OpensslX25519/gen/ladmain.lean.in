import Solutions.OpensslX25519.I.LadCSt
import Solutions.OpensslX25519.I.LadSpec
import Solutions.OpensslX25519.I.LadRun1
import Solutions.OpensslX25519.I.LadRun2
/-!
# One iteration of the ladder loop of `x25519_scalar_mult_generic`

Generated by `gen/genladmain.py`. From the loop head at `0x103990` with `esi = pos` and `edi = sw` (the swap
bit of the previous iteration) to the next loop head (or, for `pos = 0`, the exit at `0x103afd`): the bit of
the scalar copy at `pos` (`bitv`), stored in the slot at `L + 12`, two `fe_cswap`s with `sw ^ bitv`, and the 18
field calls. The buffers' values are tracked as residues (`Rep`) and end as `Spec.X25519.ladderStep` of the
residues they started with; the limb bounds stay `MulOut` (`x₁` only needs `MulIn`).
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519 Ssl.Spec.X25519 Solutions.Exec.Bit

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- Instructions of one iteration. -/
def ladK : Nat := {K}

theorem lad_iter (G N : XMem) (L : UInt32) (hS : FB G.get.size L 344)
    (out b0 s0 s1 s2 s3 : UInt32) (w : Nat → UInt32) (eb : List UInt8) (heb : EB w eb) (hlen : eb.length = 32)
    (vz3 vx2 vx3 vt0 vz2 vx1 vt1 : Array UInt32)
    (C : CSt G N L 344 1012 (ladSl out b0 w s0 s1 s2 s3)
      [(48, vz3), (88, vx2), (128, vx3), (168, vt0), (208, vz2), (248, vx1), (288, vt1)])
    (mz3 : MulOut vz3) (mx2 : MulOut vx2) (mx3 : MulOut vx3) (mz2 : MulOut vz2) (mx1 : MulIn vx1)
    (X1 X2 Z2 X3 Z3 : Nat) (rz3 : Rep vz3 Z3) (rx2 : Rep vx2 X2) (rx3 : Rep vx3 X3) (rz2 : Rep vz2 Z2)
    (rx1 : Rep vx1 X1) (pos sw : UInt32) (hpos : pos.toNat < 255) (hsw : sw = 0 ∨ sw = 1)
    (eax ecx edx ebx ebp fl : UInt32) (ic0 : UInt64) (c : Nat) (hic : ic0.toNat + c + {K} < 2 ^ 62) (s00 : Machine)
    (R : Run img s00 (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add L 8, ebp, pos, sw, 0x103990, efl fl, icAdd ic0 c⟩)) :
    ∃ (N' : XMem) (bitv : UInt32) (vz3' vx2' vx3' vt0' vz2' vt1' : Array UInt32) (eax' ecx' edx' ebx' ebp' fl' eip : UInt32),
      Run img s00 (St.m ⟨N'.get, eax', ecx', edx', ebx', UInt32.add L 8, ebp', UInt32.add pos 4294967295, bitv, eip,
        efl fl', icAdd ic0 (c + {K})⟩) ∧
      (pos.toNat ≠ 0 → eip = 0x103990) ∧ (pos.toNat = 0 → eip = 0x103afd) ∧
      CSt G N' L 344 1012 (ladSl out bitv w s0 s1 s2 s3)
        [(48, vz3'), (88, vx2'), (128, vx3'), (168, vt0'), (208, vz2'), (248, vx1), (288, vt1')] ∧
      (bitv = 0 ∨ bitv = 1) ∧ bitv.toNat = (leNat eb >>> pos.toNat) % 2 ∧
      MulOut vz3' ∧ MulOut vx2' ∧ MulOut vx3' ∧ MulOut vz2' ∧
      Rep vx2' (ladderStep X1 (X2, Z2, X3, Z3, sw.toNat) ((leNat eb >>> pos.toNat) % 2)).1 ∧
      Rep vz2' (ladderStep X1 (X2, Z2, X3, Z3, sw.toNat) ((leNat eb >>> pos.toNat) % 2)).2.1 ∧
      Rep vx3' (ladderStep X1 (X2, Z2, X3, Z3, sw.toNat) ((leNat eb >>> pos.toNat) % 2)).2.2.1 ∧
      Rep vz3' (ladderStep X1 (X2, Z2, X3, Z3, sw.toNat) ((leNat eb >>> pos.toNat) % 2)).2.2.2.1 := by
  generalize hI : icAdd ic0 c = ic1 at R
  have hic1 : ic1.toNat < 2 ^ 62 := by rw [← hI, icAdd_toNat _ _ (by omega)]; omega
  have hS0 : FB N.get.size L 344 := hS.size_eq C.pres.1
  have hq8 : (Shift.shrR pos 3).toNat = pos.toNat / 8 := Shift.shrR_toNat pos 3 (by decide) (by decide)
  have hq : (Shift.shrR pos 3).toNat < 32 := by rw [hq8]; omega
  have H1 := lh1 ic1 (by omega) N L hS0 eax ecx edx ebx ebp pos sw fl
  have H2 := lh2 (icAdd ic1 2) (icAdd_lt hic1 (by decide)) N L hS0 (Shift.shrR pos 3) ecx edx ebx ebp pos sw
    (Shift.shrF pos 3) _ hq (lad_byte C heb _ hq)
  simp only [icAdd_add] at H2
  have H3 := lh3 (icAdd ic1 5) (icAdd_lt hic1 (by decide)) N L hS0 (eb[(Shift.shrR pos 3).toNat]!).toUInt32
    (logicF 4 (pos.land 7)).1 edx ebx ebp pos sw (logicF 4 (pos.land 7)).2
  simp only [icAdd_add] at H3
  generalize hbv : setbV (logicF 4 (pos.land 7)).2 (eb[(Shift.shrR pos 3).toNat]!).toUInt32
    (logicF 4 (pos.land 7)).1 = bitv at H3
  have hb01 : bitv = 0 ∨ bitv = 1 := hbv ▸ setbV_01 _ _ _
  have hbit : bitv.toNat = (leNat eb >>> pos.toNat) % 2 := by
    rw [← hbv, hq8]; exact lad_bit _ pos eb hlen (by omega)
  have H4 := lp1 (icAdd ic1 8) (icAdd_lt hic1 (by decide)) N L hS0 bitv (logicF 4 (pos.land 7)).1 edx ebx ebp pos sw
    (mixF (logicF 4 (pos.land 7)).2 (bitU (btV (eb[(Shift.shrR pos 3).toNat]!).toUInt32 (logicF 4 (pos.land 7)).1)) 1)
  simp only [icAdd_add] at H4
  have CW := C.wr_slot 12 (by simp [ladSl]) (by decide) bitv (ladSl_al _ _ _ _ _ _ _) (by decide)
  rw [ladSl_upd] at CW
  have hbx : sw.xor bitv = 0 ∨ sw.xor bitv = 1 := bitU_xor _ _ hsw hb01
  obtain ⟨N0, a0, c0, d0, f0, RR0, C0, Mf0, Mg0⟩ := CW.cswap (by decide) (by decide) 88 128 (by decide) rfl rfl
    (sw.xor bitv) hbx 0x1039be bitv ebx ebp pos (sw.xor bitv) (logicF 4 (sw.xor bitv)).2 ic1 14 (ic_lt hic1 (by decide)) _
    (by decide) (by decide) ((((R.trans H1).trans H2).trans H3).trans H4)
  have hiff : (sw.xor bitv = 1) ↔ (sw.toNat ^^^ bitv.toNat = 1) := xor_one_iff _ _ hsw hb01
  obtain ⟨xa, ha2⟩ : ∃ xa, xa = (if sw.toNat ^^^ bitv.toNat = 1 then X3 else X2) := ⟨_, rfl⟩
  obtain ⟨xb, hb2⟩ : ∃ xb, xb = (if sw.toNat ^^^ bitv.toNat = 1 then Z3 else Z2) := ⟨_, rfl⟩
  obtain ⟨xc, hc2⟩ : ∃ xc, xc = (if sw.toNat ^^^ bitv.toNat = 1 then X2 else X3) := ⟨_, rfl⟩
  obtain ⟨xd, hd2⟩ : ∃ xd, xd = (if sw.toNat ^^^ bitv.toNat = 1 then Z2 else Z3) := ⟨_, rfl⟩
  have m88 : MulOut (memWords N0.get (UInt32.add L (88 : Nat).toUInt32) 10) := by
    rw [Mf0]; exact bound_ite MulOut _ mx2 mx3
  have m128 : MulOut (memWords N0.get (UInt32.add L (128 : Nat).toUInt32) 10) := by
    rw [Mg0]; exact bound_ite MulOut _ mx3 mx2
  have r88 : Rep (memWords N0.get (UInt32.add L (88 : Nat).toUInt32) 10) xa := by
    rw [Mf0, ha2]; exact Rep_ite _ _ hiff rx2 rx3
  have r128 : Rep (memWords N0.get (UInt32.add L (128 : Nat).toUInt32) 10) xc := by
    rw [Mg0, hc2]; exact Rep_ite _ _ hiff rx3 rx2
  have C0' := C0.set7 48 88 128 168 208 248 288 _ _ _ _ _ _ _ (by simp [keys_upd]) rfl rfl rfl rfl rfl rfl rfl
