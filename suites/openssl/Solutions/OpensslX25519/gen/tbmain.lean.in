import Solutions.OpensslX25519.I.TbMath
import Solutions.OpensslX25519.I.MemCall
import Solutions.OpensslX25519.I.Caller
/-!
# `fe_tobytes`: the output bytes

Generated by `gen/gentbmain.py` (prover Q). `tbb<j>`: byte `j` that `fe_tobytes` stores, as a function of
the ten chain words (`t0 … t9`, as natural numbers), is byte `j` of `tbVN t0 … t9`. Also the helpers of
the call contract (`I/TbCall`): byte stores into the output keep the frame (`Frame.wrO1`), the bytes
written so far (`bytes_step`), the final list (`bytes_final`).
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Solutions.OpensslX25519 Ssl.OpensslX25519

def tbVN (t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 : Nat) : Nat :=
  t0 % 2 ^ 26 + 2 ^ 26 * (t1 % 2 ^ 25) + 2 ^ 51 * (t2 % 2 ^ 26) + 2 ^ 77 * (t3 % 2 ^ 25) +
    2 ^ 102 * (t4 % 2 ^ 26) + 2 ^ 128 * (t5 % 2 ^ 25) + 2 ^ 153 * (t6 % 2 ^ 26) +
    2 ^ 179 * (t7 % 2 ^ 25) + 2 ^ 204 * (t8 % 2 ^ 26) + 2 ^ 230 * (t9 % 2 ^ 25)

theorem mod_shl_zero (t k : Nat) (hk : k ≤ 32) : t * 2 ^ k % 2 ^ 32 % 2 ^ k = 0 := by
  rw [Nat.mod_mod_of_dvd _ (Nat.pow_dvd_pow 2 hk), Nat.mul_mod_left]

/-- Outside the 32 output bytes at `out`. -/
def OutO (out : UInt32) (x : Nat) : Prop := x < out.toNat ∨ out.toNat + 32 ≤ x

theorem ok1_of (N : XMem) (a out : UInt32) (o : Nat) (ha : a.toNat = out.toNat + o) (ho : o < 32)
    (hs : out.toNat + 32 ≤ N.get.size) (hoi : out.toNat + 32 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ out.toNat) :
    StoreOk1 Image.base Image.size N.mem a :=
  ⟨by show a.toNat < N.get.size; omega,
   by rw [show Image.base.toNat = 0x100000 from rfl, show Image.size = 47024 from rfl]; omega⟩

theorem _root_.Solutions.OpensslX25519.Frame.wrO1 {N : XMem} {b : UInt32} {n : Nat} {l : List (Nat × UInt32)}
    (hF : Frame N b n l) (h : FB N.get.size b n) {a v : UInt32} (ok : StoreOk1 Image.base Image.size N.mem a)
    (hd : a.toNat < b.toNat ∨ b.toNat + n ≤ a.toNat) : Frame (CodeMem.wr1 N a v ok) b n l :=
  hF.pres h ((Pres.refl N (fun x => b.toNat ≤ x ∧ x < b.toNat + n)).wr1 ok (fun x hx => by omega))
    (fun x h1 h2 => ⟨h1, h2⟩)

theorem bytes_step (N : XMem) (out a v : UInt32) (ok : StoreOk1 Image.base Image.size N.mem a) (V k : Nat)
    (ha : a.toNat = out.toNat + k) (hk : k < 32) (hs : out.toNat + 32 ≤ N.get.size) (htop : N.get.size ≤ ramTop)
    (H : ∀ i, i < k → memByte N.get (out + i.toUInt32) = tbB V i) (hv : v.toUInt8 = tbB V k) :
    ∀ i, i < k + 1 → memByte (CodeMem.wr1 N a v ok).get (out + i.toUInt32) = tbB V i := by
  intro i hi
  have hT : N.get.size < 2 ^ 32 := by unfold ramTop at htop; omega
  have ei : (out + i.toUInt32).toNat = out.toNat + i := by
    rw [UInt32.toNat_add, Nat.toUInt32, UInt32.toNat_ofNat']; omega
  by_cases h : i = k
  · subst h
    have e : out + i.toUInt32 = a := UInt32.toNat_inj.1 (by rw [ei, ha])
    rw [e, memByte_wr1_self]; exact hv
  · rw [memByte_wr1_other N a v ok (by rw [ei]; omega) (by rw [ei, ha]; omega)]
    exact H i (by omega)

theorem bytes_final (N : XMem) (out : UInt32) (V : Nat)
    (B : ∀ i, i < 32 → memByte N.get (out + i.toUInt32) = tbB V i) :
    memBytes N.get out 32 = Ssl.Spec.X25519.leBytes 32 V := by
  unfold memBytes Ssl.Spec.X25519.leBytes
  apply List.map_congr_left
  intro i hi
  rw [List.mem_range] at hi
  rw [B i hi]
  rfl

theorem inM_of_mulOut {v : Array UInt32} (h : MulOut v) : InM (lift v) := by
  have b0 := h.2 0 (by decide)
  have b1 := h.2 1 (by decide)
  have b2 := h.2 2 (by decide)
  have b3 := h.2 3 (by decide)
  have b4 := h.2 4 (by decide)
  have b5 := h.2 5 (by decide)
  have b6 := h.2 6 (by decide)
  have b7 := h.2 7 (by decide)
  have b8 := h.2 8 (by decide)
  have b9 := h.2 9 (by decide)
  simp only [Nat.reduceMod, Nat.reduceSub, Nat.reducePow, Nat.reduceMul] at b0 b1 b2 b3 b4 b5 b6 b7 b8 b9
  simp only [InM, lift]
  omega
-- @@BYTES
end Solutions.OpensslX25519.I
-- @@MAIN
import Solutions.OpensslX25519.I.TbBytes
import Solutions.OpensslX25519.I.TbBase
import Solutions.OpensslX25519.I.TbRun1
import Solutions.OpensslX25519.I.TbRun2
import Solutions.OpensslX25519.I.TbRun3
import Solutions.OpensslX25519.I.TbRun4
import Solutions.OpensslX25519.I.TbRun5
import Solutions.OpensslX25519.I.TbRun6
import Solutions.OpensslX25519.I.TbRun7
import Solutions.OpensslX25519.Peel
/-!
# `fe_tobytes` as a callee

Generated by `gen/gentbmain.py` (prover Q). The run of `fe_tobytes(out, h)` (`out` in `ecx`, `h` in `edx`) from
its pieces (`I/TbBase`, `I/TbRun*`) at any instruction count, with the frame `[L, L + 44)` (the return address
at `L + 40`): it writes only its frame below `L + 40` and the 32 bytes at `out`, which are the little-endian
bytes of `feValI h mod p` for limbs within the `fe_mul` output bounds (`tb_chain`, `tbb<j>`).
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519 Solutions.Exec.Mul Solutions.OpensslX25519
  Solutions.Exec.Shift

attribute [local irreducible] rdRaw

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem fe_tobytes_call (G : XMem) (L out hp ret : UInt32) (fv : Array UInt32)
    (hS : FB G.get.size L 44) (hret : rdRaw G.get (UInt32.add L 40) 4 = ret)
    (hom : out.toNat + 32 ≤ G.get.size) (hoi : out.toNat + 32 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ out.toNat)
    (hoL : out.toNat + 32 ≤ L.toNat ∨ L.toNat + 44 ≤ out.toNat)
    (hpm : hp.toNat + 40 ≤ G.get.size) (hpi : hp.toNat + 40 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ hp.toNat)
    (hpL : hp.toNat + 40 ≤ L.toNat ∨ L.toNat + 44 ≤ hp.toNat)
    (hfv : memWords G.get hp 10 = fv) (hin : MulOut fv) (a0 ebx0 ebp0 esi0 edi0 fl0 : UInt32)
    (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 63) :
    ∃ (N : XMem) (eax ecx edx fl : UInt32),
      Run img (St.m ⟨G.get, a0, out, hp, ebx0, UInt32.add L 40, ebp0, esi0, edi0, 0x101c30, efl fl0, icAdd ic0 0⟩)
        (St.m ⟨N.get, eax, ecx, edx, ebx0, UInt32.add L 44, ebp0, esi0, edi0, ret, efl fl, icAdd ic0 163⟩) ∧
      Pres G N (fun x => OutF L 40 x ∧ OutO out x) ∧
      memBytes N.get out 32 = Ssl.Spec.X25519.leBytes 32 (feValI fv % pI).toNat := by
  have htop : G.get.size ≤ ramTop := hS.top
  have hT : G.get.size < 2 ^ 32 := by unfold ramTop at htop; omega
  -- the input words
  obtain ⟨x0, hx0⟩ : ∃ y : UInt32, rdRaw G.get hp 4 = y := ⟨_, rfl⟩
  have hin_x0 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get hp 4 = x0 := fun N P =>
    (P.rd htop (by omega) (fun k hk => by unfold OutF; omega)).trans hx0
  have hfv0 : fv[0]! = x0 := by
    rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx0]
    congr 1; simp
  obtain ⟨x1, hx1⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 4) 4 = y := ⟨_, rfl⟩
  have hin_x1 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 4) 4 = x1 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx1
  have hfv1 : fv[1]! = x1 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx1]; rfl
  obtain ⟨x2, hx2⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 8) 4 = y := ⟨_, rfl⟩
  have hin_x2 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 8) 4 = x2 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx2
  have hfv2 : fv[2]! = x2 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx2]; rfl
  obtain ⟨x3, hx3⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 12) 4 = y := ⟨_, rfl⟩
  have hin_x3 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 12) 4 = x3 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx3
  have hfv3 : fv[3]! = x3 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx3]; rfl
  obtain ⟨x4, hx4⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 16) 4 = y := ⟨_, rfl⟩
  have hin_x4 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 16) 4 = x4 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx4
  have hfv4 : fv[4]! = x4 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx4]; rfl
  obtain ⟨x5, hx5⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 20) 4 = y := ⟨_, rfl⟩
  have hin_x5 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 20) 4 = x5 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx5
  have hfv5 : fv[5]! = x5 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx5]; rfl
  obtain ⟨x6, hx6⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 24) 4 = y := ⟨_, rfl⟩
  have hin_x6 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 24) 4 = x6 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx6
  have hfv6 : fv[6]! = x6 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx6]; rfl
  obtain ⟨x7, hx7⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 28) 4 = y := ⟨_, rfl⟩
  have hin_x7 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 28) 4 = x7 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx7
  have hfv7 : fv[7]! = x7 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx7]; rfl
  obtain ⟨x8, hx8⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 32) 4 = y := ⟨_, rfl⟩
  have hin_x8 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 32) 4 = x8 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx8
  have hfv8 : fv[8]! = x8 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx8]; rfl
  obtain ⟨x9, hx9⟩ : ∃ y : UInt32, rdRaw G.get (UInt32.add hp 36) 4 = y := ⟨_, rfl⟩
  have hin_x9 : ∀ N : XMem, Pres G N (OutF L 40) → rdRaw N.get (UInt32.add hp 36) 4 = x9 := fun N P =>
    (P.rd htop (by simp only [toNat_uadd, UInt32.reduceToNat]; omega) (fun k hk => by
      unfold OutF; simp only [toNat_uadd, UInt32.reduceToNat]; omega)).trans hx9
  have hfv9 : fv[9]! = x9 := by rw [← hfv, memWords_getElem! _ _ _ _ (by decide), ← hx9]; rfl
  have hX : InM ⟨sv x0, sv x1, sv x2, sv x3, sv x4, sv x5, sv x6, sv x7, sv x8, sv x9⟩ := by
    have := inM_of_mulOut hin
    simp only [lift, hfv0, hfv1, hfv2, hfv3, hfv4, hfv5, hfv6, hfv7, hfv8, hfv9] at this
    exact this
  have hval : L10.val ⟨sv x0, sv x1, sv x2, sv x3, sv x4, sv x5, sv x6, sv x7, sv x8, sv x9⟩ = feValI fv := by
    rw [← lift_val]; simp only [lift, hfv0, hfv1, hfv2, hfv3, hfv4, hfv5, hfv6, hfv7, hfv8, hfv9]; rfl
  have ha0 : out.toNat = out.toNat + 0 := rfl
  have hA : ∀ k : UInt32, k.toNat < 32 → (UInt32.add out k).toNat = out.toNat + k.toNat := fun k hk => by
    rw [toNat_uadd]; omega
  have hdL : ∀ o, o < 32 → out.toNat + o < L.toNat ∨ L.toNat + 44 ≤ out.toNat + o := by intro o ho; omega
  have hdO : ∀ o, o < 32 → ∀ x, OutO out x → x ≠ out.toNat + o := by intro o ho x hx; unfold OutO at hx; omega
  have ha1 : (UInt32.add out 1).toNat = out.toNat + 1 := hA 1 (by decide)
  have ha2 : (UInt32.add out 2).toNat = out.toNat + 2 := hA 2 (by decide)
  have ha3 : (UInt32.add out 3).toNat = out.toNat + 3 := hA 3 (by decide)
  have ha4 : (UInt32.add out 4).toNat = out.toNat + 4 := hA 4 (by decide)
  have ha5 : (UInt32.add out 5).toNat = out.toNat + 5 := hA 5 (by decide)
  have ha6 : (UInt32.add out 6).toNat = out.toNat + 6 := hA 6 (by decide)
  have ha7 : (UInt32.add out 7).toNat = out.toNat + 7 := hA 7 (by decide)
  have ha8 : (UInt32.add out 8).toNat = out.toNat + 8 := hA 8 (by decide)
  have ha9 : (UInt32.add out 9).toNat = out.toNat + 9 := hA 9 (by decide)
  have ha10 : (UInt32.add out 10).toNat = out.toNat + 10 := hA 10 (by decide)
  have ha11 : (UInt32.add out 11).toNat = out.toNat + 11 := hA 11 (by decide)
  have ha12 : (UInt32.add out 12).toNat = out.toNat + 12 := hA 12 (by decide)
  have ha13 : (UInt32.add out 13).toNat = out.toNat + 13 := hA 13 (by decide)
  have ha14 : (UInt32.add out 14).toNat = out.toNat + 14 := hA 14 (by decide)
  have ha15 : (UInt32.add out 15).toNat = out.toNat + 15 := hA 15 (by decide)
  have ha16 : (UInt32.add out 16).toNat = out.toNat + 16 := hA 16 (by decide)
  have ha17 : (UInt32.add out 17).toNat = out.toNat + 17 := hA 17 (by decide)
  have ha18 : (UInt32.add out 18).toNat = out.toNat + 18 := hA 18 (by decide)
  have ha19 : (UInt32.add out 19).toNat = out.toNat + 19 := hA 19 (by decide)
  have ha20 : (UInt32.add out 20).toNat = out.toNat + 20 := hA 20 (by decide)
  have ha21 : (UInt32.add out 21).toNat = out.toNat + 21 := hA 21 (by decide)
  have ha22 : (UInt32.add out 22).toNat = out.toNat + 22 := hA 22 (by decide)
  have ha23 : (UInt32.add out 23).toNat = out.toNat + 23 := hA 23 (by decide)
  have ha24 : (UInt32.add out 24).toNat = out.toNat + 24 := hA 24 (by decide)
  have ha25 : (UInt32.add out 25).toNat = out.toNat + 25 := hA 25 (by decide)
  have ha26 : (UInt32.add out 26).toNat = out.toNat + 26 := hA 26 (by decide)
  have ha27 : (UInt32.add out 27).toNat = out.toNat + 27 := hA 27 (by decide)
  have ha28 : (UInt32.add out 28).toNat = out.toNat + 28 := hA 28 (by decide)
  have ha29 : (UInt32.add out 29).toNat = out.toNat + 29 := hA 29 (by decide)
  have ha30 : (UInt32.add out 30).toNat = out.toNat + 30 := hA 30 (by decide)
  have ha31 : (UInt32.add out 31).toNat = out.toNat + 31 := hA 31 (by decide)
-- @@DEFS
  have hV : (V : Int) = feValI fv % pI := by
    rw [eV, ← hval]
    exact tb_chain x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15 v16 v17 v18
      v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31 v32 v34 v35 v55 v56 v57 v58 v59 v60 v61 v62 v65 v66
      e_v1 e_v2 e_v3 e_v4 e_v5 e_v6 e_v7 e_v8 e_v9 e_v10 e_v11 e_v12 e_v13 e_v14 e_v15 e_v16 e_v17 e_v18 e_v19
      e_v20 e_v21 e_v22 e_v23 e_v24 e_v25 e_v26 e_v27 e_v28 e_v29 e_v30 e_v31 e_v32 e_v34 e_v35 e_v55 e_v56 e_v57
      e_v58 e_v59 e_v60 e_v61 e_v62 e_v65 e_v66 hX
  -- the run
  have F0 : Frame G L 44 [(40, ret)] := by
    intro k v hl
    rw [lookup_cons] at hl
    split at hl
    · rename_i hk; subst hk; simp only [Option.some.injEq] at hl; subst hl; exact ⟨rfl, by decide, hret⟩
    · simp at hl
  obtain ⟨N1, R1, F1, P1⟩ := tb_pro ic0 hic G L hS _ F0 a0 out hp ebx0 ebp0 esi0 edi0 fl0
  have hS1 : FB N1.get.size L 44 := hS.size_eq P1.1
  have R2 := tb_sub ic0 hic N1 L hS1 a0 out hp ebx0 ebp0 esi0 edi0 fl0
  rw [← eg0] at R2
  have Rn := R1.trans R2
  clear R1 R2
-- @@PIECES
  have r_add := tb_add ic0 hic @NF L (hS.size_eq sz@KF) @REGS @FL
  have r_epi := tb_epi ic0 hic @NF L (hS.size_eq sz@KF) @REGS (addF 4 L 24 0).2 esi0 edi0 ebx0 ebp0 ret
    (F@KF.rd (rfl : List.lookup 24 _ = some esi0) 24 rfl) (F@KF.rd (rfl : List.lookup 28 _ = some edi0) 28 rfl)
    (F@KF.rd (rfl : List.lookup 32 _ = some ebx0) 32 rfl) (F@KF.rd (rfl : List.lookup 36 _ = some ebp0) 36 rfl)
    (F@KF.rd (rfl : List.lookup 40 _ = some ret) 40 rfl)
  refine ⟨@NF, _, _, _, _, Rn.trans (r_add.trans r_epi), ?_, ?_⟩
  · have := P@B.trans Q@KF
    exact this
  · rw [bytes_final @NF out V B@KF, ← hV]
    simp

end Solutions.OpensslX25519.I
