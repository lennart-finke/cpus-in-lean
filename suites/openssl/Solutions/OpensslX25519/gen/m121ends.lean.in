import Solutions.OpensslX25519.ShapesSq1
import Solutions.OpensslX25519.ShapesSq2
import Solutions.OpensslX25519.ShapesSq3
import Solutions.OpensslX25519.ShapesSq4
import Solutions.OpensslX25519.ShapesMul1
import Solutions.OpensslX25519.ShapesMul2
import Solutions.OpensslX25519.I.ShapesM121
import Solutions.OpensslX25519.Frame
import Solutions.Exec.Mul
import Solutions.Exec.Alu
/-!
# The run of `fe_mul121666`: prologue, output stores, epilogue

The pieces around its body (`M121Run*`): the four pushes and the frame allocation (`fb = sp - 84`,
the saved registers at `fb + 68 … fb + 80`, the return address at `fb + 84`), the load of the output
pointer from `fb + 64`, the ten stores into the output buffer `hp`, the frame release, the pops and
the return. Template of gen/genm121.py (made call-level by gen/icall.py).
-/
namespace Solutions.OpensslX25519
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519 Solutions.Exec.Mul Solutions.Exec.Fast

attribute [local cbv_opaque] Image.bytes
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option cbv.maxSteps 50000000

set_option exec.addrSub true in
/-- `pushl %ebp ; pushl %ebx ; pushl %edi ; pushl %esi` -/
theorem m121_pro (G : XMem) (fb : UInt32) (hS : FB G.get.size fb 88) (l : List (Nat × UInt32))
    (hF : Frame G fb 88 l) (eax ecx edx ebx ebp esi edi f : UInt32) :
    ∃ N' : XMem, Run img (St.m ⟨G.get, eax, ecx, edx, ebx, UInt32.add fb 84, ebp, esi, edi, 0x103c00, efl f, 0⟩)
      (St.m ⟨N'.get, eax, ecx, edx, ebx, UInt32.add fb 68, ebp, esi, edi, 0x103c04, efl f, 4⟩) ∧
      Frame N' fb 88 ((68, esi) :: (72, edi) :: (76, ebx) :: (80, ebp) :: l) ∧
      Pres G N' (OutF fb 84) := by
  refine ⟨stF (stF (stF (stF G fb 88 80 ebp hS (by decide)) fb 88 76 ebx stF_FB (by decide))
    fb 88 72 edi stF_FB (by decide)) fb 88 68 esi stF_FB (by decide), run_of_runOk (k := 4) ?_,
    (((hF.wrF 80 rfl rfl).wrF 76 rfl rfl).wrF 72 rfl rfl).wrF 68 rfl rfl,
    ((((Pres.refl G _).wrF (by decide)).wrF (by decide)).wrF (by decide)).wrF (by decide)⟩
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  clear hF
  cbv

theorem m121_esp_sub (fb : UInt32) : (subF 4 (UInt32.add fb 68) 68 0).1 = fb := by
  rw [subF_fst]; show fb + 68 - 68 = fb; exact UInt32.add_sub_cancel _ _

/-- `subl $0x44, %esp` -/
theorem m121_sub (N : XMem) (fb : UInt32) (hS : FB N.get.size fb 88) (eax ecx edx ebx ebp esi edi f : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add fb 68, ebp, esi, edi, 0x103c04, efl f, 4⟩)
      (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, esi, edi, 0x103c07, efl (subF 4 (UInt32.add fb 68) 68 0).2, 5⟩) := by
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  have h : runOk img 1 (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add fb 68, ebp, esi, edi, 0x103c04, efl f, 4⟩) =
      some (St.m ⟨N.get, eax, ecx, edx, ebx, (subF 4 (UInt32.add fb 68) 68 0).1, ebp, esi, edi, 0x103c07,
        efl (subF 4 (UInt32.add fb 68) 68 0).2, 5⟩) := by
    cbv
  rw [m121_esp_sub] at h
  exact run_of_runOk h

/-- `movl 0x40(%esp), %eax`: the output pointer. -/
theorem m121_ld (N : XMem) (fb : UInt32) (hS : FB N.get.size fb 88) (eax ecx edx ebx ebp esi edi f : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e38, efl f, 161⟩)
      (St.m ⟨N.get, rdRaw N.get (UInt32.add fb 64) 4, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e3c, efl f, 162⟩) := by
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  apply run_of_runOk (k := 1)
  cbv

/-- `movl 0xc(%esp), %ebx ; movl %ebx, (%eax) ; movl 0x8(%esp), %ebx ; movl %ebx, 0x4(%eax) ;
movl 0x4(%esp), %ebx ; movl %ebx, 0x8(%eax) ; movl 0x10(%esp), %ebx ; movl %ebx, 0xc(%eax)` -/
theorem m121_o1 (G N : XMem) (fb hp : UInt32) (hS : FB N.get.size fb 88) (hH : FB N.get.size hp 40)
    (hd : hp.toNat + 40 ≤ fb.toNat ∨ fb.toNat + 88 ≤ hp.toNat) (l lh : List (Nat × UInt32))
    (hF : Frame N fb 88 l) (hFH : Frame N hp 40 lh) (hP : Pres G N (OutH fb 84 hp))
    (ecx edx ebx ebp esi edi f w0 w1 w2 w3 : UInt32) (l0 : l.lookup 12 = some w0) (l1 : l.lookup 8 = some w1)
    (l2 : l.lookup 4 = some w2) (l3 : l.lookup 16 = some w3) :
    ∃ N' : XMem, Run img (St.m ⟨N.get, hp, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e3c, efl f, 162⟩)
      (St.m ⟨N'.get, hp, ecx, edx, w3, fb, ebp, esi, edi, 0x103e57, efl f, 170⟩) ∧
      Frame N' fb 88 l ∧ Frame N' hp 40 ((12, w3) :: (8, w2) :: (4, w1) :: (0, w0) :: lh) ∧
      Pres G N' (OutH fb 84 hp) := by
  refine ⟨stF (stF (stF (stF0 N hp 40 w0 hH (by decide)) hp 40 4 w1 stF0_FB (by decide)) hp 40 8 w2 stF_FB
    (by decide)) hp 40 12 w3 stF_FB (by decide), run_of_runOk (k := 8) ?_,
    (((hF.wrH0 hS hd).wrH (hS.size_eq (by simp only [stF_size, stF0_size])) hd).wrH
      (hS.size_eq (by simp only [stF_size, stF0_size])) hd).wrH (hS.size_eq (by simp only [stF_size, stF0_size])) hd,
    ((hFH.wrF0).wrF 4 rfl rfl |>.wrF 8 rfl rfl).wrF 12 rfl rfl,
    ((hP.wrH0).wrH.wrH).wrH⟩
  have r0 := hF.rd l0 12 rfl; have r1 := hF.rd l1 8 rfl; have r2 := hF.rd l2 4 rfl; have r3 := hF.rd l3 16 rfl
  subst r0 r1 r2 r3
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img; have h4 := hH.fit; have h5 := hH.img
  clear hF hFH hP
  cbv

/-- `movl %edi, 0x10(%eax) ; movl (%esp), %edi ; movl %edi, 0x14(%eax) ; movl %esi, 0x18(%eax) ;
movl %ecx, 0x1c(%eax)` -/
theorem m121_o2 (G N : XMem) (fb hp : UInt32) (hS : FB N.get.size fb 88) (hH : FB N.get.size hp 40)
    (hd : hp.toNat + 40 ≤ fb.toNat ∨ fb.toNat + 88 ≤ hp.toNat) (l lh : List (Nat × UInt32))
    (hF : Frame N fb 88 l) (hFH : Frame N hp 40 lh) (hP : Pres G N (OutH fb 84 hp))
    (ecx edx ebx ebp esi edi f w5 : UInt32) (l5 : l.lookup 0 = some w5) :
    ∃ N' : XMem, Run img (St.m ⟨N.get, hp, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e57, efl f, 170⟩)
      (St.m ⟨N'.get, hp, ecx, edx, ebx, fb, ebp, esi, w5, 0x103e66, efl f, 175⟩) ∧
      Frame N' fb 88 l ∧ Frame N' hp 40 ((28, ecx) :: (24, esi) :: (20, w5) :: (16, edi) :: lh) ∧
      Pres G N' (OutH fb 84 hp) := by
  refine ⟨stF (stF (stF (stF N hp 40 16 edi hH (by decide)) hp 40 20 w5 stF_FB (by decide)) hp 40 24 esi stF_FB
    (by decide)) hp 40 28 ecx stF_FB (by decide), run_of_runOk (k := 5) ?_,
    (((hF.wrH hS hd).wrH (hS.size_eq (by simp only [stF_size])) hd).wrH
      (hS.size_eq (by simp only [stF_size])) hd).wrH (hS.size_eq (by simp only [stF_size])) hd,
    (((hFH.wrF 16 rfl rfl).wrF 20 rfl rfl).wrF 24 rfl rfl).wrF 28 rfl rfl,
    (((hP.wrH).wrH).wrH).wrH⟩
  have r5 := hF.rd0 l5
  subst r5
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img; have h4 := hH.fit; have h5 := hH.img
  clear hF hFH hP
  cbv

/-- `movl %edx, 0x20(%eax) ; movl %ebp, 0x24(%eax)` -/
theorem m121_o3 (G N : XMem) (fb hp : UInt32) (hS : FB N.get.size fb 88) (hH : FB N.get.size hp 40)
    (hd : hp.toNat + 40 ≤ fb.toNat ∨ fb.toNat + 88 ≤ hp.toNat) (l lh : List (Nat × UInt32))
    (hF : Frame N fb 88 l) (hFH : Frame N hp 40 lh) (hP : Pres G N (OutH fb 84 hp))
    (ecx edx ebx ebp esi edi f : UInt32) :
    ∃ N' : XMem, Run img (St.m ⟨N.get, hp, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e66, efl f, 175⟩)
      (St.m ⟨N'.get, hp, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e6c, efl f, 177⟩) ∧
      Frame N' fb 88 l ∧ Frame N' hp 40 ((36, ebp) :: (32, edx) :: lh) ∧
      Pres G N' (OutH fb 84 hp) := by
  refine ⟨stF (stF N hp 40 32 edx hH (by decide)) hp 40 36 ebp stF_FB (by decide), run_of_runOk (k := 2) ?_,
    (hF.wrH hS hd).wrH (hS.size_eq (by simp only [stF_size])) hd,
    (hFH.wrF 32 rfl rfl).wrF 36 rfl rfl,
    (hP.wrH).wrH⟩
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img; have h4 := hH.fit; have h5 := hH.img
  clear hF hFH hP
  cbv

theorem m121_esp_add (fb : UInt32) : (addF 4 fb 68 0).1 = UInt32.add fb 68 := addF_fst _ _

/-- `addl $0x44, %esp` -/
theorem m121_add (N : XMem) (fb : UInt32) (hS : FB N.get.size fb 88) (eax ecx edx ebx ebp esi edi f : UInt32) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e6c, efl f, 177⟩)
      (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add fb 68, ebp, esi, edi, 0x103e6f, efl (addF 4 fb 68 0).2, 178⟩) := by
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  have h : runOk img 1 (St.m ⟨N.get, eax, ecx, edx, ebx, fb, ebp, esi, edi, 0x103e6c, efl f, 177⟩) =
      some (St.m ⟨N.get, eax, ecx, edx, ebx, (addF 4 fb 68 0).1, ebp, esi, edi, 0x103e6f,
        efl (addF 4 fb 68 0).2, 178⟩) := by
    cbv
  rw [m121_esp_add] at h
  exact run_of_runOk h

/-- `popl %esi ; popl %edi ; popl %ebx ; popl %ebp ; retl` -/
theorem m121_epi (N : XMem) (fb : UInt32) (hS : FB N.get.size fb 88) (l : List (Nat × UInt32))
    (hF : Frame N fb 88 l) (eax ecx edx ebx ebp esi edi f esi0 edi0 ebx0 ebp0 ret : UInt32)
    (l1 : l.lookup 68 = some esi0) (l2 : l.lookup 72 = some edi0) (l3 : l.lookup 76 = some ebx0)
    (l4 : l.lookup 80 = some ebp0) (l5 : l.lookup 84 = some ret) :
    Run img (St.m ⟨N.get, eax, ecx, edx, ebx, UInt32.add fb 68, ebp, esi, edi, 0x103e6f, efl f, 178⟩)
      (St.m ⟨N.get, eax, ecx, edx, ebx0, UInt32.add fb 88, ebp0, esi0, edi0, ret, efl f, 183⟩) := by
  have r1 := hF.rd l1 68 rfl; have r2 := hF.rd l2 72 rfl; have r3 := hF.rd l3 76 rfl
  have r4 := hF.rd l4 80 rfl; have r5 := hF.rd l5 84 rfl
  subst r1 r2 r3 r4 r5
  have h1 := hS.top; have h2 := hS.fit; have h3 := hS.img
  clear hF
  apply run_of_runOk (k := 5)
  cbv

end Solutions.OpensslX25519
