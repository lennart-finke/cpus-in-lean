import Solutions.OpensslX25519.I.InvLoop
import Solutions.OpensslX25519.I.InvRun2
import Solutions.OpensslX25519.I.InvRun3
import Solutions.OpensslX25519.I.InvRun4
import Solutions.OpensslX25519.I.InvRun5
import Solutions.OpensslX25519.I.InvRun6
/-!
# `fe_invert` as a callee

Generated by `gen/geninvmain.py`. `fe_invert(out, z)` (`out` in `ecx`, `z` in `edx`) computes
`z^(p-2)` by squarings and 11 multiplications: the run is put together from the pieces between the calls
(`I/InvRun*`), the call steps of the frame state `CSt` (`I/CSt`) and the loop (`I/InvLoop`); the value
of each buffer is tracked as a power of `z` modulo `p` (`pow_sq_emod`, `pow_mul_emod`).
-/
namespace Solutions.OpensslX25519.I
open X86 Ssl Solutions.Logic Solutions.Exec Ssl.OpensslX25519

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The slots of the frame of `fe_invert`. -/
def invSlots (out esi0 edi0 ebx0 ebp0 : UInt32) : List (Nat × UInt32) :=
  [(8, out), (172, esi0), (176, edi0), (180, ebx0), (184, ebp0)]

theorem fe_invert_call (G : XMem) (sp hp fp ret : UInt32) (fv : Array UInt32)
    (F : Facts1W 1016 G.get.size sp.toNat hp.toNat fp.toNat) (hret0 : rdRaw G.get sp 4 = ret)
    (hfv : memWords G.get fp 10 = fv) (hin : MulIn fv) (a0 ebx0 ebp0 esi0 edi0 fl0 : UInt32)
    (ic0 : UInt64) (hic : ic0.toNat < 2 ^ 62) :
    ∃ (N : XMem) (eax ecx edx fl : UInt32),
      Run img (St.m ⟨G.get, a0, hp, fp, ebx0, sp, ebp0, esi0, edi0, 0x1005d0, efl fl0, ic0⟩)
        (St.m ⟨N.get, eax, ecx, edx, ebx0, sp + 4, ebp0, esi0, edi0, ret, efl fl, icAdd ic0 {K}⟩) ∧
      Pres G N (OutH (sp - 1016) 1016 hp) ∧
      MulOut (memWords N.get hp 10) ∧ feValI (memWords N.get hp 10) % pI = feValI fv ^ (2 ^ 255 - 21) % pI := by
  have htop : G.get.size ≤ ramTop := F.ram
  have hsp := F.sp_lo
  obtain ⟨L, hL⟩ : ∃ L : UInt32, L = sp - (188 : Nat).toUInt32 := ⟨_, rfl⟩
  have hLN : L.toNat = sp.toNat - 188 := by rw [hL]; exact fb_toNatW F.sp_lo 188 (by decide)
  have hspL : sp = UInt32.add L 188 := by
    apply UInt32.toNat_inj.1; rw [toNat_uadd, hLN]; have := sp.toNat_lt
    simp only [UInt32.reduceToNat]; omega
  have hS : FB G.get.size L 192 := ⟨htop, by have := F.sp_hi; omega, by have := F.sp_img; omega⟩
  have F0 : Frame G L 192 [(188, ret)] := by
    intro k v hl
    simp only [List.lookup] at hl
    split at hl
    · rename_i h; simp at h; subst h; simp at hl; subst hl
      refine ⟨rfl, by decide, ?_⟩
      rw [show UInt32.add L (188 : Nat).toUInt32 = sp from hspL.symm]; exact hret0
    · simp at hl
  have e0 : St.m ⟨G.get, a0, hp, fp, ebx0, sp, ebp0, esi0, edi0, 0x1005d0, efl fl0, ic0⟩ =
      St.m ⟨G.get, a0, hp, fp, ebx0, UInt32.add L 188, ebp0, esi0, edi0, 0x1005d0, efl fl0, icAdd ic0 0⟩ := by
    rw [← hspL]; rfl
  rw [e0]
  have R1 := inv_pro ic0 (by omega) G L hS a0 hp fp ebx0 ebp0 esi0 edi0 fl0
  have FA := (((F0.wrF 184 (j := 184) (v := ebp0) (h := hS) (hj := by decide) rfl rfl).wrF 180 (j := 180)
    (v := ebx0) (h := stF_FB) (hj := by decide) rfl rfl).wrF 176 (j := 176) (v := edi0) (h := stF_FB) (hj := by decide)
    rfl rfl).wrF 172 (j := 172) (v := esi0) (h := stF_FB) (hj := by decide) rfl rfl
  generalize hM1 : stF (stF (stF (stF G L 192 184 ebp0 hS (by decide)) L 192 180 ebx0 stF_FB (by decide)) L 192 176
    edi0 stF_FB (by decide)) L 192 172 esi0 stF_FB (by decide) = M1 at R1 FA
  have PA : Pres G M1 (OutF L 188) := by
    rw [← hM1]
    exact ((((Pres.refl G _).wrF (by decide)).wrF (by decide)).wrF (by decide)).wrF (by decide)
  have hS1 : FB M1.get.size L 192 := hS.pres PA
  have R2 := inv_sub (icAdd ic0 4) (by rw [icAdd_toNat _ _ (by omega)]; omega) M1 L hS1 a0 hp fp ebx0 ebp0 esi0 edi0 fl0
  have R3 := inv_c0a (icAdd (icAdd ic0 4) 1) (by rw [icAdd_add, icAdd_toNat _ _ (by omega)]; omega) M1 L hS1 a0 hp fp
    ebx0 ebp0 esi0 edi0 (subF 4 (UInt32.add L 172) 164 0).2
  simp only [icAdd_add] at R2 R3
  have FB2 := FA.wrF 8 (j := 8) (v := hp) (h := hS1) (hj := by decide) rfl rfl
  generalize hM2 : stF M1 L 192 8 hp hS1 (by decide) = M2 at R3 FB2
  have PB : Pres G M2 (OutF L 188) := by rw [← hM2]; exact PA.wrF (by decide)
  have C0 : CSt G M2 L 188 828 (invSlots hp esi0 edi0 ebx0 ebp0)
      ([12, 52, 92, 132].map fun j => (j, memWords M2.get (UInt32.add L j.toUInt32) 10)) := by
    have hsz : M2.get.size = G.get.size := PB.1
    refine ⟨by rw [hsz]; exact htop, by rw [hsz]; exact F.fit, by omega, by rw [hsz]; have := F.sp_hi; omega,
      by have := F.sp_img; omega, PB.mono fun x hx => by unfold OutF; omega,
      fun k v hl => (FB2 k v (lookup_append_some (l2 := [(188, ret)]) hl)).2.2,
      fun k v hl => ?_, by simp only [invSlots, List.map]; decide⟩
    simp only [List.map, List.lookup] at hl
    split at hl
    · rename_i h; simp at h hl; subst h hl; rfl
    split at hl
    · rename_i h; simp at h hl; subst h hl; rfl
    split at hl
    · rename_i h; simp at h hl; subst h hl; rfl
    split at hl
    · rename_i h; simp at h hl; subst h hl; rfl
    simp at hl
  have RR0 := R1.trans (R2.trans R3)
  have hfm := F.f_mem; have hfi := F.f_img; have hfs := F.f_stk
  have hhm := F.h_mem; have hhi := F.h_img; have hhs := F.h_stk
  have E0 : feValI fv % pI = feValI fv ^ 1 % pI := pow_one_emod _ _
  have hfs' : fp.toNat + 40 ≤ L.toNat - 828 ∨ L.toNat + 188 ≤ fp.toNat := by omega
  have hhs' : hp.toNat + 40 ≤ L.toNat - 828 ∨ L.toNat + 188 ≤ hp.toNat := by omega
  have hSpre : L.toNat + 192 ≤ G.get.size := by have := F.sp_hi; omega
  have himgL : L.toNat + 192 ≤ 0x100000 ∨ 0x100000 + 47024 ≤ L.toNat := by have := F.sp_img; omega
  have hesp : UInt32.add L 192 = sp + 4 := by
    rw [hspL]; apply UInt32.toNat_inj.1
    rw [toNat_uadd, UInt32.toNat_add, toNat_uadd]
    have := hS.fit; unfold ramTop at htop; simp only [UInt32.reduceToNat]; omega
  have hsL : (sp - 1016).toNat = L.toNat - 828 := by
    rw [UInt32.toNat_sub]; unfold ramTop at htop; simp only [UInt32.reduceToNat]; omega
  have hret188 : rdRaw G.get (UInt32.add L 188) 4 = ret := F0.rd (rfl : List.lookup 188 _ = some ret) 188 rfl
  have e188 : (UInt32.add L 188).toNat = L.toNat + 188 := by
    rw [hS.add_toNat (j := 188) (by decide)]; rfl
  have hr1 : (UInt32.add L 188).toNat + 4 ≤ G.get.size := by rw [e188]; exact hSpre
  have hr2 : ∀ k, k < 4 → ((UInt32.add L 188).toNat + k < L.toNat - 828 ∨ L.toNat + 188 ≤ (UInt32.add L 188).toNat + k)
      ∧ ((UInt32.add L 188).toNat + k < hp.toNat ∨ hp.toNat + 40 ≤ (UInt32.add L 188).toNat + k) := by
    intro k hk; rw [e188]; omega
  have hkey : ∀ x, OutH (sp - 1016) 1016 hp x →
      (x < L.toNat - 828 ∨ L.toNat + 188 ≤ x) ∧ (x < hp.toNat ∨ hp.toNat + 40 ≤ x) := by
    intro x hx; unfold OutH OutF at hx; rw [hsL] at hx; omega
