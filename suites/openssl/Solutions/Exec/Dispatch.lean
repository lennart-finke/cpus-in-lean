import X86
/-!
# Dispatch of the opcodes the targets use

`X86.execOne op` is a `match` on `op` with a catch-all case for the opcodes without extension hooks;
`cbv` cannot use the catch-all equation (it has side conditions). `execOne_base` proves it, and its
instances below, one per opcode of the one-byte map and the `0F` opcodes the targets use, let `cbv`
go on to `X86.execBase`.
-/
namespace Solutions.Exec
open X86

theorem execOne_base (op : Nat) (h1 : op < 0x200)
    (h2 : op ≠ 0x105 ∧ op ≠ 0x107 ∧ op ≠ 0x134 ∧ op ≠ 0x135 ∧ op ≠ 0x10D ∧ op ≠ 0x118 ∧ op ≠ 0x133 ∧
      op ≠ 0x109 ∧ op ≠ 0x1B8 ∧ op ≠ 0x1BC ∧ op ≠ 0x1BD ∧ op ≠ 0x112 ∧ op ≠ 0x116 ∧ op ≠ 0x12B ∧
      op ≠ 0x178 ∧ op ≠ 0x179 ∧ op ≠ 0x17C ∧ op ≠ 0x17D ∧ op ≠ 0x1D0 ∧ op ≠ 0x1F0 ∧ op ≠ 0x120 ∧
      op ≠ 0x122 ∧ op ≠ 0x101 ∧ op ≠ 0x1AE ∧ op ≠ 0x1C7 ∧ op ≠ 0x130 ∧ op ≠ 0x132) :
    execOne op = execBase op := by
  unfold execOne
  split <;> first | omega | simp [h1]

theorem execOp00_range (op : Nat) (h : 0x40 ≤ op ∧ op < 0x60) : execOp00 op = execRange op := by
  unfold execOp00
  split <;> first | omega | rfl

theorem execOp60_range (op : Nat) (h : 0x70 ≤ op ∧ op < 0x80) : execOp60 op = execRange op := by
  unfold execOp60
  split <;> first | omega | rfl

theorem execOpA0_range (op : Nat) (h : 0xB0 ≤ op ∧ op < 0xC0) : execOpA0 op = execRange op := by
  unfold execOpA0
  split <;> first | omega | rfl

